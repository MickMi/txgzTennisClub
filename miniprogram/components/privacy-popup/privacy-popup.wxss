.mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 9999;
}

.popup {
  width: 580rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 48rpx 40rpx 36rpx;
}

.title {
  font-size: 32rpx;
  font-weight: 600;
  color: #243a30;
  text-align: center;
  margin-bottom: 24rpx;
}

.content {
  font-size: 28rpx;
  color: #5d6e63;
  line-height: 1.6;
  margin-bottom: 40rpx;
  text-align: center;
}

.actions {
  display: flex;
  gap: 24rpx;
}

.btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 500;
  text-align: center;
  padding: 0;
  margin: 0;
}

.btn.cancel {
  background: #f0ece2;
  color: #5d6e63;
}

.btn.confirm {
  background: #243a30;
  color: #f8f4e8;
}

.btn::after {
  display: none;
}
