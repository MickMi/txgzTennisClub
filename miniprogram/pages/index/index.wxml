<view class="container">
  <!-- Masthead -->
  <view class="masthead">
    <view class="masthead-left">
      <view class="wordmark">活动</view>
      <view class="wordmark-caption">ACTIVITIES</view>
    </view>
    <view class="masthead-actions">
      <view class="icon-pill" bindtap="goCreate">
        <icon name="plus" size="28" />
      </view>
    </view>
  </view>

  <!-- Filter segmented control -->
  <view class="filter-bar">
    <view
      class="filter-tab {{filter === 'open' ? 'is-active' : ''}}"
      data-filter="open"
      bindtap="onFilterChange"
    >报名中</view>
    <view
      class="filter-tab {{filter === 'joined' ? 'is-active' : ''}}"
      data-filter="joined"
      bindtap="onFilterChange"
    >已报名</view>
    <view
      class="filter-tab {{filter === 'all' ? 'is-active' : ''}}"
      data-filter="all"
      bindtap="onFilterChange"
    >全部</view>
  </view>

  <block wx:if="{{!loading && list.length === 0}}">
    <view class="empty-state">
      <image class="empty-icon" src="/assets/icons/clock.svg" />
      <view class="empty-eyebrow">EMPTY · {{filter === 'joined' ? '暂无已报名活动' : filter === 'open' ? '暂无报名中活动' : '暂无活动'}}</view>
      <view class="empty-title">{{filter === 'joined' ? '还没有报名任何活动' : '还没有活动'}}</view>
      <view class="empty-desc">{{filter === 'joined' ? '在「报名中」找一场加入' : '组织一场，邀请伙伴一起运动'}}</view>
      <view wx:if="{{filter !== 'joined'}}" class="empty-cta" bindtap="goCreate">
        <text>创建活动</text>
        <text class="empty-arrow">→</text>
      </view>
    </view>
  </block>

  <view
    wx:for="{{list}}"
    wx:key="_id"
    class="card {{item.joined ? 'is-joined' : ''}}"
    data-id="{{item._id}}"
    bindtap="goDetail"
  >
    <view class="card-eyebrow">
      <text>{{item.weekdayText}} · {{item.dateShort}}</text>
      <text wx:if="{{item.joined}}" class="joined-pill">已报名 · JOINED</text>
    </view>
    <view class="card-title">{{item.title}}</view>
    <view class="card-meta">
      <view class="meta-item"><icon name="pin" size="28" /><text>{{item.location}}</text></view>
      <view class="meta-item"><icon name="people" size="28" /><text class="display-num">{{item.joinedCount}}/{{item.maxPeople || '∞'}}</text></view>
    </view>
    <view class="card-foot">
      <view class="card-status {{item.status === 'closed' ? 'tag--closed' : ''}}">
        {{item.status === 'closed' ? '已结束' : '报名中'}} · <text class="display-num">{{item.joinedCount}}</text> <text class="mono-unit">人</text>
      </view>
      <icon name="arrow-right" size="32" class="card-arrow" />
    </view>
  </view>

  <view wx:if="{{loadingMore}}" class="loading-more">加载中…</view>
  <view wx:if="{{!hasMore && list.length > 0}}" class="loading-more loading-more--end">— 已经到底了 —</view>
</view>

