/* index 活动列表页 */
.meta-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
}
.card-status {
  color: var(--color-fg);
}
.card-status.tag--closed {
  color: var(--color-muted);
}

/* 已报名活动 — 左侧 emerald-deep 强调线 + eyebrow 行右侧 chip */
.card.is-joined {
  border-left: 4rpx solid var(--color-emerald-deep);
  padding-left: calc(var(--space-5) - 4rpx);
}
.card.is-joined .card-eyebrow {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.joined-pill {
  display: inline-block;
  padding: 4rpx 14rpx;
  border: 1rpx solid var(--color-emerald-deep);
  font-family: var(--font-mono);
  font-size: 18rpx;
  letter-spacing: 0.18em;
  color: var(--color-emerald-deep);
  text-transform: uppercase;
  background: transparent;
}

/* Empty state — emerald-heritage ghost style */
.empty-state {
  display: flex; flex-direction: column; align-items: center;
  justify-content: center; min-height: 60vh; padding: 0 60rpx;
}
.empty-icon { width: 80rpx; height: 80rpx; margin-bottom: 32rpx; }
.empty-eyebrow {
  font-family: var(--font-mono); font-size: var(--text-mono-sm);
  letter-spacing: 0.22em; text-transform: uppercase;
  color: var(--color-accent); margin-bottom: 24rpx;
}
.empty-title {
  font-family: var(--font-display); font-size: 44rpx; font-weight: 500;
  color: var(--color-fg); margin-bottom: 12rpx;
}
.empty-desc {
  font-family: var(--font-mono); font-size: 22rpx; letter-spacing: 0.12em;
  color: var(--color-muted); text-transform: uppercase; margin-bottom: 48rpx;
}
.empty-cta {
  display: flex; align-items: center; gap: 16rpx;
  border: 3rpx solid var(--color-fg); padding: 24rpx 40rpx;
  font-family: var(--font-display); font-size: 28rpx; color: var(--color-fg);
  background: transparent;
}
.empty-arrow {
  font-family: var(--font-mono); color: var(--color-accent);
}

/* Filter segmented control — emerald-heritage hairline style
   去掉全宽底线，让分割只通过 active tab 的下划线呈现 */
.filter-bar {
  display: flex;
  margin: 0 32rpx 16rpx;
}
.filter-tab {
  flex: 1;
  padding: 20rpx 0;
  text-align: center;
  font-family: var(--font-mono);
  font-size: 22rpx;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--color-muted);
  border-bottom: 3rpx solid transparent;
  transition: color 0.18s, border-color 0.18s;
}
.filter-tab.is-active {
  color: var(--color-fg);
  border-bottom-color: var(--color-emerald-deep);
}

/* Loading-more / end-of-list footer */
.loading-more {
  text-align: center;
  padding: 32rpx 0 48rpx;
  font-family: var(--font-mono);
  font-size: 22rpx;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--color-muted);
}
.loading-more--end {
  color: var(--color-border);
}
