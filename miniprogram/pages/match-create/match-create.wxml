<view class="container">
  <view class="form-content">
    <view class="form-row">
      <text class="form-label">TITLE · 比赛名 <text class="required">*</text></text>
      <input class="form-input" placeholder="例如：5 月月赛-决赛"
        value="{{form.title}}" data-key="title" bindinput="onInput" maxlength="40" />
    </view>

    <view class="form-row">
      <text class="form-label">LEVEL · 级别 <text class="required">*</text></text>
      <picker bindchange="onLevelChange" value="{{levelIndex}}"
        range="{{levelOptions}}" range-key="label">
        <view class="form-picker">
          <text>{{levelOptions[levelIndex].label}}</text>
          <text class="picker-desc">{{levelOptions[levelIndex].desc}}</text>
        </view>
      </picker>
      <view class="level-points">
        胜者 +{{levelOptions[levelIndex].winPts}} / 负者 +{{levelOptions[levelIndex].losePts}}
        <text wx:if="{{form.type === 'doubles'}}"> (双打 ×0.8)</text>
      </view>
    </view>

    <view class="form-row">
      <text class="form-label">TYPE · 类型 <text class="required">*</text></text>
      <picker bindchange="onTypeChange" value="{{typeIndex}}"
        range="{{typeOptions}}" range-key="label">
        <view class="form-picker">{{typeOptions[typeIndex].label}}</view>
      </picker>
    </view>

    <view class="form-row">
      <text class="form-label">FORMAT · 赛制 <text class="required">*</text></text>
      <picker bindchange="onBestOfChange" value="{{bestOfIndex}}"
        range="{{bestOfOptions}}">
        <view class="form-picker">先赢 {{bestOfOptions[bestOfIndex]}} 盘</view>
      </picker>
    </view>

    <view class="form-row">
      <text class="form-label">DATE · 比赛日期 <text class="required">*</text></text>
      <picker mode="date" value="{{form.matchDate}}" bindchange="onDateChange">
        <view class="form-picker">{{form.matchDate || '请选择'}}</view>
      </picker>
    </view>

    <view class="form-row">
      <text class="form-label">HANDICAP · 让分规则</text>
      <input class="form-input" placeholder="如：男让女每盘 2 局" value="{{form.handicapRule}}" data-key="handicapRule" bindinput="onInput" maxlength="100" />
      <view class="field-hint">仅作提示展示，不影响比分计算</view>
    </view>
  </view>

  <view class="muted tip">
    创建后选手先报名，人齐后由创建者点击"随机分组"，系统自动打乱分配到 A/B 方。比赛结束后录入总比分即可。
  </view>

  <view class="form-cta-bar">
    <button class="cta-primary" bindtap="onSubmit" disabled="{{submitting}}">
      创建比赛
    </button>
  </view>
</view>
