/* Container: top safe area + side padding */
.container {
  padding-top: 120rpx;
  padding-left: 48rpx;
  padding-right: 48rpx;
  padding-bottom: 200rpx;
}

/* Form rows — label + input 左对齐，分隔线全宽 */
.form-row {
  padding: 32rpx 0 24rpx;
  border-bottom: 1rpx solid var(--color-border);
}
.form-row:last-child { border-bottom: none; }

.form-label {
  display: block;
  font-family: var(--font-mono);
  font-size: 19rpx;
  letter-spacing: 0.22em;
  text-transform: uppercase;
  color: var(--color-muted);
  margin-bottom: 16rpx;
}
.form-label .required {
  color: var(--color-accent);
}

.form-input {
  width: 100%;
  background: transparent;
  border: none;
  padding: 0;
  font-family: var(--font-body);
  font-size: 30rpx;
  color: var(--color-fg);
  line-height: 1.4;
  min-height: 48rpx;
}

.form-textarea {
  width: 100%;
  background: transparent;
  border: none;
  padding: 0;
  font-family: var(--font-body);
  font-size: 30rpx;
  color: var(--color-fg);
  line-height: 1.5;
  min-height: 120rpx;
}

.form-picker {
  padding: 0;
  background: transparent;
  font-family: var(--font-body);
  font-size: 30rpx;
  color: var(--color-fg);
  min-height: 48rpx;
  line-height: 48rpx;
}

/* Submit button - fixed at bottom */
.form-cta-bar {
  position: fixed; bottom: 0; left: 0; right: 0;
  background: var(--color-surface); border-top: 1rpx solid var(--color-border);
  padding: 28rpx 48rpx 60rpx;
}

/* Match-specific */
.picker-desc {
  margin-left: 16rpx;
  font-size: 24rpx;
  color: var(--color-muted);
}

.level-points {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: var(--color-accent);
  font-family: var(--font-mono);
}

.field-hint {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--color-muted);
}
