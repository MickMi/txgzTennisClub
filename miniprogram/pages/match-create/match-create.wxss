.field {
  margin-bottom: 28rpx;
}

.label {
  font-size: 26rpx;
  color: var(--color-muted);
  margin-bottom: 12rpx;
}

.input, .picker {
  height: 80rpx;
  background: var(--color-bg);
  border-radius: 0;
  padding: 0 24rpx;
  line-height: 80rpx;
  font-size: 30rpx;
}

.picker-desc {
  margin-left: 16rpx;
  font-size: 24rpx;
  color: var(--color-muted);
}

.level-points {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--color-accent);
  padding-left: 4rpx;
  font-family: var(--font-mono);
}

.field-hint {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--color-muted);
}

.tip {
  margin: 20rpx 10rpx;
  line-height: 1.6;
}

.submit {
  margin-top: 20rpx;
}
