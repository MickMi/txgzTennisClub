<view class="container">
  <!-- 页面标题 -->
  <view class="page-header">
    <view class="page-title">积分排行榜</view>
    <view class="page-subtitle" wx:if="{{myRank > 0}}"><text>我的排名</text> <text class="display-num">#{{myRank}}</text></view>
  </view>

  <!-- 排行榜列表 -->
  <view wx:if="{{loading && list.length === 0}}" class="muted" style="text-align: center; padding: 80rpx 0;">
    加载中...
  </view>

  <view wx:if="{{!loading && list.length === 0}}" class="empty-state">
    <view class="empty-icon"><icon name="trophy" size="112" /></view>
    <view class="empty-title">暂无排名数据</view>
    <view class="empty-desc">参加赛事获得积分后即可上榜</view>
  </view>

  <view
    wx:for="{{list}}"
    wx:key="openid"
    class="ranking-row {{item.openid === myOpenid ? 'my-row' : ''}}"
    data-openid="{{item.openid}}"
    data-name="{{item.wecomName}}"
    bindtap="goUserDetail"
  >
    <view class="ranking-rank {{item.rank <= 3 ? 'top3' : ''}}">{{item.rank}}</view>
    <view class="avatar" style="{{item.gender === 'female' ? 'border-color: var(--color-accent); color: var(--color-accent);' : ''}}">{{item.wecomName[0]}}</view>
    <view class="ranking-info">
      <text class="player-name">{{item.wecomName}}</text>
      <text class="player-rating {{item.rating ? '' : 'unrated'}}">{{item.rating ? 'NTRP ' + item.rating : ''}}</text>
    </view>
    <view class="ranking-pts">{{item.totalPoints}}</view>
  </view>

  <view class="ranking-footer">
    总积分 = 最佳10场赛事收益之和
  </view>
</view>
