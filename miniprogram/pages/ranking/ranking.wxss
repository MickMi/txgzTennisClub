/* ranking 排行榜页 */
.container {
  /* padding-top 走 inline 动态：navTop + 64(按钮高) + 24(气口) = navTop + 88rpx */
  padding-left: 48rpx;
  padding-right: 48rpx;
}
.page-header {
  padding-bottom: var(--space-4);
  border-bottom: var(--border-strong);
  margin-bottom: var(--space-4);
}
.page-title {
  font-family: var(--font-display);
  font-size: var(--text-display-md);
  color: var(--color-fg);
}
.page-subtitle {
  font-size: var(--text-mono-md);
  color: var(--color-accent);
  margin-top: 8rpx;
}

.ranking-info {
  min-width: 0;
  flex: 1;
}

.ranking-footer {
  margin-top: 48rpx;
  font-size: 18rpx;
  color: var(--color-muted);
  text-align: center;
  padding-bottom: 48rpx;
}
