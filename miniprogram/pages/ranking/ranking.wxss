/* 我的排名卡片 */
.my-rank-card {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  padding: 30rpx;
  background: linear-gradient(135deg, #e8f5e9, #c8e6c9);
}

.my-rank-label {
  font-size: 28rpx;
  color: #333;
}

.my-rank-num {
  font-size: 56rpx;
  font-weight: 700;
  color: #1aad19;
}

/* 排行榜 */
.rank-card {
  padding: 0;
  overflow: hidden;
}

.rank-header {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  background: #f5f6f7;
  font-size: 22rpx;
  color: #888;
  font-weight: 500;
}

.rh-rank {
  width: 70rpx;
  text-align: center;
}

.rh-name {
  flex: 1;
}

.rh-rating {
  width: 80rpx;
  text-align: center;
}

.rh-elo {
  width: 90rpx;
  text-align: center;
}

.rh-pts {
  width: 100rpx;
  text-align: right;
}

.rank-row {
  display: flex;
  align-items: center;
  padding: 22rpx 24rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.rank-row:last-child {
  border-bottom: none;
}

.rank-row.rank-me {
  background: #f0faf0;
}

.rank-num {
  width: 70rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 600;
  color: #666;
}

.rank-info {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.rank-name {
  font-size: 28rpx;
  color: #333;
}

.rank-rating {
  font-size: 20rpx;
  padding: 2rpx 10rpx;
  background: #e8f5e9;
  color: #1aad19;
  border-radius: 6rpx;
}

.rank-elo {
  width: 90rpx;
  text-align: center;
  font-size: 24rpx;
  color: #666;
}

.rank-pts {
  width: 100rpx;
  text-align: right;
  font-size: 32rpx;
  font-weight: 700;
  color: #ff9800;
}
