<view class="container">
  <!-- Masthead -->
  <view class="masthead">
    <view class="masthead-left">
      <view class="wordmark">我的</view>
      <view class="wordmark-caption">PROFILE</view>
    </view>
    <view class="masthead-actions">
      <view class="icon-pill" bindtap="onEdit">
        <icon name="pencil" size="32" />
      </view>
    </view>
  </view>

  <!-- 个人信息卡片 -->
  <view class="card profile-card">
    <view class="avatar"><icon name="tennis" size="112" /></view>
    <block wx:if="{{!editing}}">
      <view class="name">{{user.wecomName || '未登记'}}</view>
      <view class="gender-tag" wx:if="{{user.gender}}">{{user.gender === 'male' ? '男' : '女'}}</view>
      <view class="muted" wx:if="{{user.role === 'admin'}}">管理员</view>
      <button class="btn-default edit-btn" bindtap="onEdit">修改信息</button>
    </block>
    <block wx:else>
      <input
        class="input"
        placeholder="企业微信名"
        value="{{wecomNameInput}}"
        bindinput="onInput"
        maxlength="20"
      />
      <view class="gender-edit">
        <radio-group bindchange="onGenderChange" class="gender-group-inline">
          <label class="gender-opt {{genderInput === 'male' ? 'sel' : ''}}">
            <radio value="male" checked="{{genderInput === 'male'}}" color="#243a30" />
            <text>男</text>
          </label>
          <label class="gender-opt {{genderInput === 'female' ? 'sel' : ''}}">
            <radio value="female" checked="{{genderInput === 'female'}}" color="#243a30" />
            <text>女</text>
          </label>
        </radio-group>
      </view>
      <view class="row btns">
        <button class="btn-default flex1" bindtap="onCancel">取消</button>
        <view style="width: 20rpx;"></view>
        <button class="btn-primary flex1" bindtap="onSave">保存</button>
      </view>
    </block>
  </view>

  <!-- 评级 & 积分卡片 -->
  <view class="card">
    <view class="section-title">当前评级 (NTRP)</view>
    <view class="rating-row">
      <view class="rating-value {{rating === '未设置' ? 'muted' : ''}}">{{rating}}</view>
      <block wx:if="{{!editingRating}}">
        <view class="rating-edit-btn" bindtap="onEditRating">修改</view>
      </block>
      <block wx:else>
        <picker mode="selector" range="{{ratingOptions}}" value="{{ratingIndex}}" bindchange="onRatingChange">
          <view class="rating-edit-btn">选择评级</view>
        </picker>
        <view class="rating-cancel-btn" bindtap="onCancelRating">取消</view>
      </block>
    </view>
    <view class="rating-hint muted">NTRP 1.0(初学) ~ 7.0(职业)</view>

    <view class="divider" style="margin: 24rpx 0;"></view>

    <view class="stats-inline">
      <view class="stat-inline-item">
        <view class="stat-inline-num points-color">{{totalPoints}}</view>
        <view class="stat-inline-label">总积分</view>
      </view>
      <view class="stat-inline-item">
        <view class="stat-inline-num elo-color">{{eloRating}}</view>
        <view class="stat-inline-label">ELO等级分</view>
      </view>
    </view>
    <view class="rating-hint muted">总积分=最佳10场赛事收益 · ELO反映实力水平</view>
  </view>

  <!-- 战绩统计卡片 -->
  <view class="card">
    <view class="section-title">战绩统计</view>
    <view class="stats-row">
      <view class="stat-item">
        <view class="stat-num win-color">{{stats.wins}}</view>
        <view class="stat-label">胜</view>
      </view>
      <view class="stat-item">
        <view class="stat-num loss-color">{{stats.losses}}</view>
        <view class="stat-label">负</view>
      </view>
      <view class="stat-item">
        <view class="stat-num">{{stats.total}}</view>
        <view class="stat-label">总场次</view>
      </view>
      <view class="stat-item">
        <view class="stat-num">{{winRate}}</view>
        <view class="stat-label">胜率</view>
      </view>
    </view>
  </view>

  <!-- 趋势图表 -->
  <view class="card chart-card">
    <view class="chart-tabs">
      <view class="chart-tab {{chartTab === 0 ? 'chart-tab-active elo-active' : ''}}" data-tab="0" bindtap="onChartTabChange">ELO 趋势</view>
      <view class="chart-tab {{chartTab === 1 ? 'chart-tab-active pts-active' : ''}}" data-tab="1" bindtap="onChartTabChange">积分趋势</view>
    </view>
    <view class="chart-container">
      <canvas id="trendChart" type="2d" class="trend-canvas"></canvas>
    </view>
  </view>

  <!-- Tab 切换：历史战绩 / 参与活动 -->
  <view class="card tab-card">
    <view class="tab-bar">
      <view class="tab-item {{activeTab === 0 ? 'tab-active' : ''}}" data-tab="0" bindtap="onTabChange">历史战绩</view>
      <view class="tab-item {{activeTab === 1 ? 'tab-active' : ''}}" data-tab="1" bindtap="onTabChange">参与的活动</view>
    </view>

    <!-- 历史战绩列表 -->
    <view wx:if="{{activeTab === 0}}">
      <view wx:if="{{matchHistory.length === 0}}" class="empty-state-sm">
        <view class="empty-icon-sm"><icon name="tennis" size="112" /></view>
        <view class="empty-title-sm">暂无比赛记录</view>
        <view class="empty-desc-sm">参加一场比赛，这里会记录你的每一次精彩对决</view>
        <button class="btn-primary empty-btn-sm" bindtap="goMatchTab">去参加比赛</button>
      </view>
      <view wx:for="{{matchHistory}}" wx:key="_id" class="list-item" data-id="{{item._id}}" bindtap="goMatchDetail">
        <view class="list-item-top">
          <text class="list-item-title">{{item.title}}</text>
          <text class="result-tag {{item.resultClass}}">{{item.resultText}}</text>
        </view>
        <view class="list-item-meta muted">
          <text>{{item.matchDateStr}}</text>
          <text wx:if="{{item.scoreSummary}}"> · {{item.scoreSummary}}</text>
          <text> · {{item.type === 'doubles' ? '双打' : '单打'}}</text>
        </view>
      </view>
    </view>

    <!-- 参与的活动列表 -->
    <view wx:if="{{activeTab === 1}}">
      <view wx:if="{{activities.length === 0}}" class="empty-state-sm">
        <view class="empty-icon-sm"><icon name="list" size="112" /></view>
        <view class="empty-title-sm">暂无参与的活动</view>
        <view class="empty-desc-sm">去活动列表报名参加，和大家一起打球吧</view>
        <button class="btn-primary empty-btn-sm" bindtap="goActivityTab">去报名活动</button>
      </view>
      <view wx:for="{{activities}}" wx:key="_id" class="list-item" data-id="{{item._id}}" bindtap="goActivityDetail">
        <view class="list-item-top">
          <text class="list-item-title">{{item.title}}</text>
          <text class="status-tag {{item.status === 'open' ? 'open' : 'closed'}}">{{item.status === 'open' ? '进行中' : '已结束'}}</text>
        </view>
        <view class="list-item-meta muted">
          <text>{{item.startTimeStr}}</text>
          <text> · {{item.location}}</text>
          <text> · </text><text class="display-num">{{item.participantCount}}</text><text class="mono-unit">人</text><text>参与</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 关于 -->
  <view class="card">
    <view class="row-between item" hover-class="hover">
      <text>关于本小程序</text>
      <text class="muted">v1.1.0</text>
    </view>
    <view class="divider"></view>
    <view class="row-between item">
      <text>使用说明</text>
      <text class="muted">仅限社团内部</text>
    </view>
  </view>

  <view class="muted tip">
    本工具用于腾讯广州网球社内部活动与比赛记录，仅收集你的企微名，不会用于其他用途。
  </view>
</view>
