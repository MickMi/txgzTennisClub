<wxs module="fmt">
module.exports = {
  firstChar: function(name) {
    return name ? name.charAt(0) : '?';
  },
  day: function(dateStr) {
    if (!dateStr) return '--';
    var d = getDate(dateStr);
    return d.getDate();
  },
  month: function(dateStr) {
    if (!dateStr) return '';
    var months = ['JAN','FEB','MAR','APR','MAY','JUN','JUL','AUG','SEP','OCT','NOV','DEC'];
    var d = getDate(dateStr);
    return months[d.getMonth()];
  }
};
</wxs>

<view class="container">
  <!-- Masthead -->
  <view class="masthead">
    <view class="masthead-left">
      <view class="wordmark">我的</view>
      <view class="wordmark-caption">PROFILE</view>
    </view>
    <view class="masthead-actions">
      <view class="icon-pill" bindtap="onEdit">
        <icon name="pencil" size="28" />
      </view>
    </view>
  </view>

  <!-- 1. Profile Hero -->
  <view class="profile-hero">
    <view class="avatar">{{fmt.firstChar(user.wecomName)}}</view>
    <view class="who">
      <view class="name">{{user.wecomName || '未登记'}}</view>
      <view class="role">
        <block wx:if="{{user.role === 'admin'}}">
          <text class="role-badge accent">ADMIN</text>
          <text class="role-muted"> · 管理员</text>
        </block>
        <text class="role-badge muted" wx:else>MEMBER</text>
      </view>
    </view>
  </view>

  <!-- 2. Identity Grid -->
  <view class="identity-grid">
    <view class="cell">
      <text class="lbl">NTRP</text>
      <text class="val">{{rating}}</text>
      <view class="delta flat">—</view>
    </view>
    <view class="cell">
      <text class="lbl">积分</text>
      <text class="val">{{totalPoints}}</text>
      <view class="delta">+0</view>
    </view>
    <view class="cell">
      <text class="lbl">ELO</text>
      <text class="val">{{eloRating}}</text>
      <view class="delta">+0</view>
    </view>
  </view>

  <!-- 3. Stats Strip -->
  <view class="stats-strip">
    <view class="stat win">
      <text class="n">{{stats.wins}}</text>
      <text class="l">胜</text>
    </view>
    <view class="stat">
      <text class="n">{{stats.losses}}</text>
      <text class="l">负</text>
    </view>
    <view class="stat">
      <text class="n">{{stats.pending}}</text>
      <text class="l">待录</text>
    </view>
    <view class="stat">
      <text class="n">{{stats.total}}</text>
      <text class="l">总计</text>
    </view>
  </view>

  <!-- 4. Chart Block -->
  <view class="chart-block">
    <view class="chart-tabs">
      <view class="tab {{chartTab === 0 ? 'is-active' : ''}}" data-tab="0" bindtap="onChartTabChange">ELO</view>
      <view class="tab {{chartTab === 1 ? 'is-active' : ''}}" data-tab="1" bindtap="onChartTabChange">积分</view>
    </view>
    <view class="chart-canvas-wrap">
      <canvas id="trendChart" type="2d" class="profile-chart"></canvas>
    </view>
    <view class="chart-foot">
      <text>{{chartTab === 0 ? 'ELO TREND' : 'POINTS TREND'}}</text>
      <text>CURRENT <text class="chart-foot-val">{{chartTab === 0 ? eloRating : totalPoints}}</text></text>
    </view>
  </view>

  <!-- ADMIN-ONLY: 成员管理入口 -->
  <view wx:if="{{user.role === 'admin'}}" class="admin-entry" bindtap="goMemberManagement">
    <view class="admin-entry-left">
      <text class="admin-entry-eyebrow">ADMIN</text>
      <text class="admin-entry-title">成员管理</text>
    </view>
    <text class="admin-entry-arrow">→</text>
  </view>

  <!-- 5. Recent Block -->
  <view class="recent-block">
    <view class="recent-eyebrow">
      <text>近期比赛</text>
      <text class="meta">RECENT MATCHES</text>
      <text class="arrow">→</text>
    </view>

    <block wx:if="{{matchHistory.length > 0}}">
      <view
        wx:for="{{matchHistory}}"
        wx:key="_id"
        class="match-row {{item.resultClass === 'loss' ? 'is-loss' : ''}} {{item.resultClass === 'pending' ? 'is-pending' : ''}}"
        data-id="{{item.tournamentId}}"
        bindtap="goMatchDetail"
      >
        <view class="when">
          <text class="d">{{fmt.day(item.matchDate)}}</text>
          <text class="m">{{fmt.month(item.matchDate)}}</text>
        </view>
        <view class="who">
          <view class="title">{{item.title}}</view>
          <view class="vs">{{item.type === 'doubles' ? 'DOUBLES' : 'SINGLES'}}</view>
        </view>
        <text class="score">{{item.scoreSummary || item.resultText}}</text>
      </view>
    </block>

    <view wx:else class="no-data">NO DATA</view>
  </view>

  <!-- Edit Overlay (keeps existing JS logic working) -->
  <view wx:if="{{editing}}" class="edit-overlay" bindtap="onCancel">
    <view class="edit-panel" catchtap="">
      <view class="edit-heading">修改信息</view>
      <input
        class="edit-input"
        placeholder="企业微信名"
        value="{{wecomNameInput}}"
        bindinput="onInput"
        maxlength="20"
      />
      <view class="edit-gender">
        <radio-group bindchange="onGenderChange">
          <label class="gender-opt {{genderInput === 'male' ? 'sel' : ''}}">
            <radio value="male" checked="{{genderInput === 'male'}}" color="#b87a36" />
            <text>男</text>
          </label>
          <label class="gender-opt {{genderInput === 'female' ? 'sel' : ''}}">
            <radio value="female" checked="{{genderInput === 'female'}}" color="#b87a36" />
            <text>女</text>
          </label>
        </radio-group>
      </view>
      <view class="edit-rating">
        <text class="edit-rating-label">NTRP 等级</text>
        <picker mode="selector" range="{{ratingOptions}}" value="{{ratingIndex}}" bindchange="onRatingChange">
          <view class="edit-rating-picker">{{rating === '未设置' ? '选择等级' : rating}}</view>
        </picker>
      </view>
      <view class="edit-actions">
        <view class="edit-btn cancel" bindtap="onCancel">CANCEL</view>
        <view class="edit-btn save" bindtap="onSave">SAVE</view>
      </view>
    </view>
  </view>
</view>
