/* ============ Profile Hero ============ */
.profile-hero {
  padding: 36rpx 48rpx 44rpx;
  display: grid;
  grid-template-columns: 156rpx 1fr;
  column-gap: 36rpx;
  align-items: center;
}

.profile-hero .avatar-wrap {
  width: 156rpx;
  height: 156rpx;
  border-radius: 50%;
  border: 3rpx solid var(--color-accent);
  overflow: hidden;
  display: grid;
  place-items: center;
  background: var(--color-surface);
  /* 因为现在是 <button open-type="chooseAvatar">，需要 reset 默认按钮样式 */
  padding: 0;
  margin: 0;
  line-height: 1;
}

.profile-hero .avatar-wrap::after {
  display: none;
}

.profile-hero .avatar-img {
  width: 156rpx;
  height: 156rpx;
  border-radius: 50%;
}

.profile-hero .avatar-letter {
  font-family: var(--font-display);
  font-size: 64rpx;
  font-weight: 500;
  color: var(--color-fg);
}

.profile-hero .who {
  min-width: 0;
}

.profile-hero .name {
  font-family: var(--font-display);
  font-size: 52rpx;
  font-weight: 500;
  line-height: 1.1;
  color: var(--color-fg);
  letter-spacing: 0.005em;
}

.profile-hero .role {
  margin-top: 12rpx;
  display: flex;
  align-items: center;
}

.profile-hero .role-badge {
  font-family: var(--font-mono);
  font-size: 20rpx;
  letter-spacing: 0.22em;
  color: var(--color-accent);
  text-transform: uppercase;
}

.profile-hero .pip {
  display: inline-block;
  width: 8rpx;
  height: 8rpx;
  background: var(--color-border);
  border-radius: 50%;
  margin: 0 16rpx;
}

.profile-hero .joined {
  font-family: var(--font-mono);
  font-size: 20rpx;
  letter-spacing: 0.18em;
  color: var(--color-muted);
  text-transform: uppercase;
}

/* ============ Register Prompt ============ */
.register-prompt {
  margin: 0 48rpx 32rpx;
  padding: 28rpx 32rpx;
  background: #faf8f2;
  border: 1rpx dashed #ddd6c4;
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.register-prompt-text {
  font-size: 24rpx;
  color: #8a7e6a;
}
.register-prompt-btn {
  font-size: 24rpx;
  color: #b87a36;
  font-weight: 600;
}

/* ============ Identity Grid ============ */
.identity-grid {
  margin: 8rpx 48rpx 0;
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  border-top: 2rpx solid var(--color-fg);
  border-bottom: 1rpx solid var(--color-border);
}

.identity-grid .cell {
  padding: 28rpx 0 28rpx;
  border-inline-start: 1rpx solid var(--color-border);
  padding-inline-start: 28rpx;
  display: flex;
  flex-direction: column;
}

.identity-grid .cell:first-child {
  border-inline-start: none;
  padding-inline-start: 0;
}

.identity-grid .lbl {
  font-family: var(--font-mono);
  font-size: 18rpx;
  letter-spacing: 0.22em;
  color: var(--color-muted);
  text-transform: uppercase;
  margin-bottom: 12rpx;
  display: block;
}

.identity-grid .val {
  font-family: var(--font-display);
  font-size: 52rpx;
  font-weight: 500;
  line-height: 1;
  color: var(--color-fg);
  font-feature-settings: 'lnum', 'tnum';
  letter-spacing: -0.005em;
}

.identity-grid .delta {
  display: block; margin-top: 12rpx;
  font-family: var(--font-mono); font-size: 20rpx;
  color: var(--color-muted); font-feature-settings: 'tnum';
  letter-spacing: 0.06em;
}
.identity-grid .delta.up { color: var(--color-accent); }
.identity-grid .delta.down { color: #c0392b; }
.identity-grid .delta.flat { color: var(--color-muted); }

/* ============ Stats Strip ============ */
.stats-strip-header {
  margin: 0 48rpx;
  padding-top: 12rpx;
}

.stats-mode-tabs {
  display: flex;
  gap: 0;
  border-bottom: 1rpx solid var(--color-border);
}

.stats-mode-tab {
  font-family: var(--font-mono);
  font-size: 21rpx;
  letter-spacing: 0.12em;
  color: var(--color-muted);
  padding: 16rpx 24rpx 16rpx 0;
  margin-inline-end: 28rpx;
  position: relative;
}

.stats-mode-tab.is-active {
  color: var(--color-fg);
}

.stats-mode-tab.is-active::after {
  content: '';
  position: absolute;
  left: 0;
  right: 24rpx;
  bottom: -1rpx;
  height: 3rpx;
  background: var(--color-fg);
}

.stats-strip {
  margin: 0 48rpx;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  border-bottom: 1rpx solid var(--color-border);
  padding: 24rpx 0;
}

.stats-strip .stat {
  text-align: center;
  line-height: 1.1;
}

.stats-strip .stat .n {
  font-family: var(--font-display);
  font-size: 36rpx;
  font-weight: 500;
  color: var(--color-fg);
  font-feature-settings: 'tnum', 'lnum';
}

.stats-strip .stat .l {
  display: block;
  margin-top: 8rpx;
  font-family: var(--font-mono);
  font-size: 18rpx;
  letter-spacing: 0.18em;
  color: var(--color-muted);
  text-transform: uppercase;
}

.stats-strip .stat.win .n {
  color: var(--color-success);
}

/* ============ Chart Block ============ */
.chart-block {
  margin: 44rpx 48rpx 0;
}

.chart-tabs {
  display: flex;
  gap: 0;
  border-bottom: 1rpx solid var(--color-border);
  margin-bottom: 24rpx;
}

.chart-tabs .tab {
  font-family: var(--font-mono);
  font-size: 21rpx;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--color-muted);
  padding: 20rpx 28rpx 20rpx 0;
  margin-inline-end: 36rpx;
  position: relative;
}

.chart-tabs .tab.is-active {
  color: var(--color-fg);
}

.chart-tabs .tab.is-active::after {
  content: '';
  position: absolute;
  left: 0;
  right: 28rpx;
  bottom: -1rpx;
  height: 4rpx;
  background: var(--color-accent);
}

.chart-canvas-wrap {
  width: 100%;
}

.profile-chart {
  width: 100%;
  height: 336rpx;
}

.chart-foot {
  display: grid;
  grid-template-columns: 1fr auto;
  column-gap: 32rpx;
  margin-top: 16rpx;
  padding: 20rpx 0 0;
  font-family: var(--font-mono);
  font-size: 19rpx;
  letter-spacing: 0.18em;
  color: var(--color-muted);
  text-transform: uppercase;
}

.chart-foot strong,
.chart-foot-val {
  color: var(--color-fg);
  font-family: var(--font-display);
  font-weight: 500;
  font-size: 28rpx;
  letter-spacing: 0;
  text-transform: none;
  font-feature-settings: 'tnum', 'lnum';
}

/* ============ Admin Entry（管理员功能入口） ============ */
.admin-entry {
  margin: 40rpx 48rpx 0;
  padding: 28rpx 32rpx;
  border: 1rpx solid var(--color-emerald-deep);
  border-left: 4rpx solid var(--color-emerald-deep);
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.admin-entry-left {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}
.admin-entry-eyebrow {
  font-family: var(--font-mono);
  font-size: 18rpx;
  letter-spacing: 0.22em;
  text-transform: uppercase;
  color: var(--color-accent);
}
.admin-entry-title {
  font-family: var(--font-display);
  font-size: 30rpx;
  color: var(--color-fg);
}
.admin-entry-arrow {
  font-family: var(--font-mono);
  font-size: 28rpx;
  color: var(--color-emerald-deep);
}

/* ============ Recent Block ============ */
.recent-block {
  margin: 40rpx 48rpx 0;
  padding-bottom: 60rpx;
}

.recent-eyebrow {
  display: grid;
  grid-template-columns: 1fr auto auto;
  column-gap: 28rpx;
  align-items: baseline;
  font-family: var(--font-mono);
  font-size: 20rpx;
  letter-spacing: 0.22em;
  text-transform: uppercase;
  color: var(--color-fg);
  border-top: 1rpx solid var(--color-fg);
  padding-top: 24rpx;
  margin-bottom: 24rpx;
}

.recent-eyebrow .meta {
  color: var(--color-muted);
  font-size: 18rpx;
}

.recent-eyebrow .arrow {
  color: var(--color-muted);
}

.match-row {
  display: grid;
  grid-template-columns: 72rpx 1fr auto;
  column-gap: 24rpx;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--color-border);
  align-items: center;
}

.match-row .when {
  line-height: 1.05;
  font-family: var(--font-display);
  color: var(--color-fg);
  font-feature-settings: 'lnum', 'tnum';
  text-align: center;
}

.match-row .when .d {
  font-size: 36rpx;
  display: block;
  font-weight: 500;
}

.match-row .when .m {
  font-family: var(--font-mono);
  font-size: 17rpx;
  letter-spacing: 0.2em;
  color: var(--color-muted);
  text-transform: uppercase;
  display: block;
  margin-top: 4rpx;
}

.match-row .who {
  min-width: 0;
}

.match-row .title {
  font-size: 27rpx;
  color: var(--color-fg);
  line-height: 1.25;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.match-row .vs {
  margin-top: 8rpx;
  font-family: var(--font-mono);
  font-size: 20rpx;
  color: var(--color-muted);
  letter-spacing: 0.05em;
  text-transform: uppercase;
}

.match-row .score {
  font-family: var(--font-display);
  font-weight: 500;
  font-size: 34rpx;
  line-height: 1;
  color: var(--color-fg);
  font-feature-settings: 'tnum', 'lnum';
  text-align: end;
  min-width: 80rpx;
}

.match-row.is-loss .score {
  color: var(--color-muted);
}

.match-row.is-pending .score {
  color: var(--color-accent);
  font-size: 22rpx;
  font-family: var(--font-mono);
  letter-spacing: 0.16em;
  text-transform: uppercase;
}

.no-data {
  padding: 60rpx 0;
  text-align: center;
  font-family: var(--font-mono);
  font-size: 20rpx;
  letter-spacing: 0.22em;
  color: var(--color-muted);
  text-transform: uppercase;
}

/* ============ Edit Overlay ============ */
.edit-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(31, 46, 34, 0.4);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}

.edit-panel {
  width: 600rpx;
  background: var(--color-bg);
  padding: 48rpx;
  border-top: 2rpx solid var(--color-fg);
}

.edit-heading {
  font-family: var(--font-mono);
  font-size: 20rpx;
  letter-spacing: 0.22em;
  text-transform: uppercase;
  color: var(--color-muted);
  margin-bottom: 28rpx;
}

.edit-input {
  height: 80rpx;
  background: var(--color-surface);
  padding: 0 24rpx;
  font-size: 30rpx;
  color: var(--color-fg);
  border-bottom: 2rpx solid var(--color-fg);
}

.edit-gender {
  margin-top: 24rpx;
}

.edit-gender radio-group {
  display: flex;
  gap: 32rpx;
}

.gender-opt {
  display: flex;
  align-items: center;
  padding: 12rpx 0;
  font-size: 28rpx;
  color: var(--color-fg);
}

.gender-opt.sel {
  color: var(--color-accent);
}

.edit-rating {
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid var(--color-border);
}
.edit-rating-label {
  display: block;
  font-family: var(--font-mono);
  font-size: 19rpx;
  letter-spacing: 0.22em;
  text-transform: uppercase;
  color: var(--color-muted);
  margin-bottom: 12rpx;
}
.edit-rating-picker {
  font-family: var(--font-display);
  font-size: 30rpx;
  color: var(--color-fg);
  padding: 16rpx 0;
}

.edit-actions {
  display: flex;
  justify-content: flex-end;
  gap: 24rpx;
  margin-top: 36rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid var(--color-border);
}

.edit-btn {
  font-family: var(--font-mono);
  font-size: 20rpx;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  padding: 16rpx 28rpx;
}

.edit-btn.cancel {
  color: var(--color-muted);
}

.edit-btn.save {
  color: var(--color-accent);
}

/* ============ QR Invite Section ============ */
.qr-section {
  margin: 48rpx 48rpx 80rpx;
  padding: 32rpx 36rpx;
  border: 1rpx solid var(--color-border);
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.qr-text { flex: 1; }

.qr-eyebrow {
  font-family: var(--font-mono);
  font-size: 18rpx;
  letter-spacing: 0.18em;
  color: var(--color-accent);
  text-transform: uppercase;
  margin-bottom: 4rpx;
}

.qr-title {
  font-family: var(--font-display);
  font-size: 28rpx;
  font-weight: 500;
  color: var(--color-fg);
}

.qr-desc {
  margin-top: 6rpx;
  font-family: var(--font-mono);
  font-size: 20rpx;
  color: var(--color-muted);
  letter-spacing: 0.06em;
}

.qr-img {
  width: 120rpx;
  height: 120rpx;
  flex-shrink: 0;
}
