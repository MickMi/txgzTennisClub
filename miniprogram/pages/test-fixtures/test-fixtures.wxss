.container {
  min-height: 100vh;
  background: var(--color-bg);
  padding: 48rpx 32rpx 96rpx;
  box-sizing: border-box;
}

.masthead {
  margin-top: 96rpx;
  margin-bottom: 48rpx;
}

.masthead-left .wordmark {
  font-size: 56rpx;
  font-weight: 500;
  color: var(--color-fg);
  letter-spacing: 0.5rpx;
}

.masthead-left .wordmark-caption {
  font-family: var(--font-mono, monospace);
  font-size: 22rpx;
  color: var(--color-muted);
  letter-spacing: 2rpx;
  margin-top: 8rpx;
}

.warn-card {
  background: var(--color-surface);
  border: 1rpx solid var(--color-border);
  border-radius: 8rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 48rpx;
}

.warn-text {
  font-size: 26rpx;
  color: var(--color-muted);
  line-height: 1.6;
}

.section-title {
  font-family: var(--font-mono, monospace);
  font-size: 22rpx;
  color: var(--color-muted);
  letter-spacing: 2rpx;
  margin-bottom: 24rpx;
}

.scenario-list {
  margin-bottom: 64rpx;
}

.scenario-btn {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  text-align: left;
  padding: 16rpx 32rpx;
  margin: 0 0 24rpx;
  border-radius: 0;
  line-height: 1.4;
}

.scenario-btn::after {
  border: none;
}

.scenario-btn:last-child {
  margin-bottom: 0;
}

.scenario-index {
  font-family: var(--font-mono, monospace);
  font-size: 26rpx;
  color: var(--color-muted);
  margin-right: 16rpx;
  white-space: nowrap;
  flex-shrink: 0;
  min-width: 48rpx;
  text-align: left;
}

.scenario-label {
  font-size: 30rpx;
  color: var(--color-fg);
  white-space: normal;
  word-break: break-word;
}

.cleanup-section {
  margin-top: 32rpx;
  padding-top: 32rpx;
  border-top: 1rpx solid var(--color-border);
}
