/* activity-detail 页面样式 */
.page {
  background: var(--color-bg);
  min-height: 100vh;
  padding-bottom: 200rpx;
}

/* Hero 区使用全局 .hero（深绿渐变），加 court-lines 纹理 + 顶部 nav */
.hero {
  position: relative;
  overflow: hidden;
}
.court-bg {
  position: absolute;
  inset: 0;
  opacity: 0.28;
  pointer-events: none;
}
.court-bg-img {
  width: 100%;
  height: 100%;
}
.hero .topnav {
  position: absolute;
  /* top 由 wxml inline style 注入 */
  left: 32rpx;
  z-index: 5;
}
.hero .topnav .icon-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  border: 1rpx solid rgba(248, 244, 232, 0.4);
  display: grid;
  place-items: center;
  background: rgba(36, 58, 48, 0.4);
}
.hero .hero-kicker,
.hero .hero-title,
.hero .hero-organiser {
  position: relative;
  z-index: 2;
}

.content {
  padding: 0 var(--space-5);
}

.event-meta {
  margin-bottom: 48rpx;
}

.section {
  margin-top: 48rpx;
}

/* 管理区 */
.admin-section {
  margin-top: 64rpx;
}
.admin-btns {
  display: flex;
  gap: 20rpx;
}
.admin-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  min-height: 80rpx;
  font-size: var(--text-body-sm);
  line-height: 1.3;
  padding: 12rpx 16rpx;
  box-sizing: border-box;
  white-space: normal;
  word-break: keep-all;
}

/* 关闭报名按钮（独立一行，强调态） */
.admin-close-btn {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  margin-bottom: 24rpx;
  border-color: var(--color-emerald-deep);
  color: var(--color-emerald-deep);
}

/* CTA 底栏 */
.cta-status {
  line-height: 1.1;
}
.cta-cancel {
  padding: 24rpx 36rpx;
  border-radius: 0;
  font-size: var(--text-body-lg);
}
