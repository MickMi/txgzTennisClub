/* activity-detail 页面样式 */
.page {
  background: var(--color-bg);
  min-height: 100vh;
  padding-bottom: 200rpx;
}

.content {
  padding: 0 var(--space-5);
}

.event-meta {
  margin-bottom: 48rpx;
}

.section {
  margin-top: 48rpx;
}

/* 管理区 */
.admin-section {
  margin-top: 64rpx;
}
.admin-btns {
  display: flex;
  gap: 20rpx;
}
.admin-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  height: 80rpx;
  font-size: var(--text-body-sm);
  padding: 0 16rpx;
}

/* CTA 底栏 */
.cta-status {
  line-height: 1.1;
}
.cta-cancel {
  padding: 24rpx 36rpx;
  border-radius: 0;
  font-size: var(--text-body-lg);
}
