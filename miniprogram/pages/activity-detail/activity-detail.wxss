.big {
  font-size: 38rpx;
  margin-bottom: 16rpx;
}

.meta {
  color: #555;
  margin-top: 10rpx;
  font-size: 28rpx;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
}

.export-btn {
  font-size: 26rpx;
  color: #1aad19;
  padding: 6rpx 16rpx;
  border: 1rpx solid #1aad19;
  border-radius: 8rpx;
}

.participant {
  display: flex;
  align-items: center;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.participant:last-child {
  border-bottom: none;
}

.participant-info {
  display: flex;
  align-items: center;
  flex: 1;
}

.participant-name {
  font-size: 28rpx;
  color: #333;
}

.participant-rating {
  margin-left: 12rpx;
  font-size: 22rpx;
  padding: 2rpx 12rpx;
  border-radius: 6rpx;
  background: #e8f5e9;
  color: #1aad19;
  font-weight: 500;
}

.participant-rating.no-rating {
  background: #f5f5f5;
  color: #bbb;
  font-weight: 400;
}

.dot {
  width: 50rpx;
  height: 50rpx;
  background: #e8f5e9;
  border-radius: 50%;
  text-align: center;
  line-height: 50rpx;
  margin-right: 16rpx;
  font-size: 26rpx;
}

.actions {
  margin-top: 30rpx;
}

.admin-actions {
  margin-top: 30rpx;
  display: flex;
  gap: 20rpx;
}

.btn-edit {
  flex: 1;
  background: #fff;
  color: #576b95;
  border: 1rpx solid #576b95;
  border-radius: 12rpx;
  font-size: 28rpx;
  height: 80rpx;
  line-height: 80rpx;
}

.btn-delete {
  flex: 1;
  background: #fff;
  color: #e53935;
  border: 1rpx solid #e53935;
  border-radius: 12rpx;
  font-size: 28rpx;
  height: 80rpx;
  line-height: 80rpx;
}
