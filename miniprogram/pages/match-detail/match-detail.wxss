.big {
  font-size: 38rpx;
  margin-bottom: 16rpx;
}

.meta {
  color: var(--color-muted);
  margin-top: 10rpx;
  font-size: 28rpx;
}

.handicap-rule {
  color: var(--color-accent);
  font-weight: 500;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
}

/* 报名列表 */
.player-item {
  display: flex;
  align-items: center;
  padding: 14rpx 0;
  border-bottom: var(--border-hairline);
  font-size: 28rpx;
}

.player-item:last-child {
  border-bottom: none;
}

.player-gender {
  margin-right: 12rpx;
  font-size: 28rpx;
}

.actions {
  margin-top: 24rpx;
}

.randomize-btn {
  margin-top: 20rpx;
}

/* VS 对阵 */
.vs {
  display: flex;
  align-items: stretch;
  margin-top: 16rpx;
}

.team-block {
  flex: 1;
  background: var(--color-bg);
  border-radius: 0;
  padding: 20rpx;
  text-align: center;
}

.team-block.win {
  background: var(--color-surface);
}

.team-label {
  font-size: 26rpx;
  color: var(--color-muted);
  margin-bottom: 10rpx;
}

.player {
  font-size: 30rpx;
  font-weight: 600;
  margin: 8rpx 0;
}

.vs-text {
  align-self: center;
  margin: 0 16rpx;
  color: var(--color-disabled);
}

/* 比分展示 */
.score-display {
  text-align: center;
  padding: 20rpx 0;
}

.score-big {
  font-size: 64rpx;
  font-weight: 700;
  color: var(--color-fg);
  letter-spacing: 8rpx;
  font-family: var(--font-display);
}

.winner-badge {
  margin-top: 16rpx;
  padding: 12rpx 24rpx;
  background: transparent;
  color: var(--color-success);
  border: 1rpx solid var(--color-success);
  border-radius: 0;
  font-weight: 600;
  display: inline-block;
}

.points-info {
  margin-top: 12rpx;
  font-size: 24rpx;
}

.points-win {
  color: var(--color-success);
  margin-right: 24rpx;
}

.points-lose {
  color: var(--color-muted);
}

/* 录分输入 */
.score-input-row {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 20rpx;
}

.score-side {
  text-align: center;
}

.score-side-label {
  font-size: 24rpx;
  color: var(--color-muted);
  margin-bottom: 8rpx;
}

.score-input {
  width: 140rpx;
  height: 100rpx;
  background: var(--color-bg);
  border-radius: 0;
  text-align: center;
  font-size: 48rpx;
  font-weight: 700;
  font-family: var(--font-display);
}

.score-colon {
  font-size: 48rpx;
  font-weight: 700;
  margin: 30rpx 24rpx 0;
  color: var(--color-fg);
}

.btns {
  margin-top: 24rpx;
}

.flex1 { flex: 1; }

.link {
  color: var(--color-accent);
  font-size: 26rpx;
}
