.ranking-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.ranking-entry-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.ranking-icon {
  font-size: 36rpx;
}

.ranking-text {
  font-size: 30rpx;
  font-weight: 500;
  color: #333;
}

.ranking-arrow {
  font-size: 36rpx;
  color: #ccc;
}

.meta {
  color: #666;
  font-size: 26rpx;
  margin-top: 10rpx;
}
