/* match-list 赛事列表页 */
.ranking-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 0;
  border-bottom: var(--border-strong);
  margin-bottom: var(--space-4);
}
.ranking-entry-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.ranking-text {
  font-family: var(--font-display);
  font-size: var(--text-display-sm);
  color: var(--color-fg);
}
.ranking-arrow {
  color: var(--color-accent);
}
.meta-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
}
