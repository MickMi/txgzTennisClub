<view class="container">
  <!-- Masthead -->
  <view class="masthead">
    <view class="masthead-left">
      <view class="wordmark" bindtap="onTitleTap">赛事</view>
      <view class="wordmark-caption">TOURNAMENTS</view>
    </view>
    <view class="masthead-actions">
      <view wx:if="{{showCreate}}" class="icon-pill" bindtap="goCreate">
        <icon name="plus" size="28" />
      </view>
    </view>
  </view>

  <!-- 使用范围声明 -->
  <view class="scope-notice">本小程序仅限腾讯广州网球社内部成员使用</view>

  <!-- 排行榜特征卡 -->
  <view class="ranking-feature" bindtap="goRanking">
    <view class="crest">
      <image class="crest-icon" src="/assets/icons/trophy-accent.svg" />
    </view>
    <view class="body">
      <view class="eyebrow">LEADERBOARD</view>
      <view class="title">积分排行榜</view>
    </view>
    <view class="my-rank">
      <text class="strong">{{myRank > 0 ? myRank : '—'}}/{{totalMembers > 0 ? totalMembers : '—'}}</text>
      <text class="lbl">MY RANK</text>
    </view>
  </view>

  <!-- 赛事分区标题 -->
  <view class="tournament-eyebrow">
    <text>赛事</text>
    <text class="meta">TOURNAMENTS</text>
    <text class="meta">{{tournaments.length}}</text>
  </view>

  <!-- 空状态 -->
  <block wx:if="{{!loading && tournaments.length === 0}}">
    <view class="empty-state">
      <view class="empty-icon"><icon name="trophy" size="112" /></view>
      <view class="empty-title">暂无赛事记录</view>
      <view class="empty-desc">比赛开始后，这里将展示赛事比分与对阵数据</view>
      <button wx:if="{{showCreate}}" class="cta-primary" style="width: 320rpx;" bindtap="goCreate">创建赛事</button>
    </view>
  </block>

  <!-- 赛事列表 -->
  <view class="tournament-list" wx:if="{{tournaments.length > 0}}">
    <view
      wx:for="{{tournaments}}"
      wx:key="_id"
      class="tournament-row {{item.status === 'finished' ? 'is-finished' : ''}}"
      data-id="{{item._id}}"
      bindtap="goTournamentDetail"
    >
      <view class="level">
        <text class="num">{{index < 9 ? '0' : ''}}{{index + 1}}</text>
        <view class="pip"></view>
        <text>{{item.levelText}}</text>
      </view>
      <view class="title">{{item.title}}</view>
      <view class="status-pill" data-status="{{item.status}}">{{item.statusText}}</view>
      <view class="meta-row">
        <view class="meta-cell">
          <text class="lbl">DATE</text>
          <text class="val">{{item.dateText}}</text>
        </view>
        <view class="meta-cell">
          <text class="lbl">PLAYERS</text>
          <text class="val">{{item.playerCount}}<text class="em">人</text></text>
        </view>
        <view class="meta-cell">
          <text class="lbl">FORMAT</text>
          <text class="val">{{item.type === 'team' ? '团队赛' : item.type === 'doubles' ? '双打' : '单打'}}</text>
        </view>
      </view>
    </view>
  </view>
</view>
