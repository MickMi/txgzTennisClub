<view class="container">
  <!-- 排行榜入口 -->
  <view class="ranking-entry" bindtap="goRanking">
    <view class="ranking-entry-left">
      <icon name="trophy" size="40" />
      <text class="ranking-text">积分排行榜</text>
    </view>
    <icon name="arrow-right" size="32" class="ranking-arrow" />
  </view>

  <!-- 赛事列表 -->
  <block wx:if="{{!loading && tournaments.length === 0}}">
    <view class="empty-state">
      <view class="empty-icon"><icon name="trophy" size="112" /></view>
      <view class="empty-title">还没有赛事</view>
      <view class="empty-desc">组织一场赛事，抽签分组自动化管理</view>
      <button class="cta-primary" style="width: 320rpx;" bindtap="goCreate">创建赛事</button>
    </view>
  </block>

  <view
    wx:for="{{tournaments}}"
    wx:key="_id"
    class="card"
    data-id="{{item._id}}"
    bindtap="goTournamentDetail"
  >
    <view class="card-eyebrow">{{item.levelText}} · {{item.type === 'doubles' ? 'DOUBLES' : 'SINGLES'}}</view>
    <view class="card-title">{{item.title}}</view>
    <view class="card-meta">
      <view class="meta-item"><icon name="clock" size="28" /><text>{{item.dateText}}</text></view>
      <view class="meta-item"><icon name="people" size="28" /><text>{{item.playerCount}}人</text></view>
    </view>
    <view class="card-foot">
      <view class="card-status">{{item.statusText}}</view>
      <icon name="arrow-right" size="32" class="card-arrow" />
    </view>
  </view>
</view>

<view class="fab" bindtap="goCreate"><icon name="plus" size="48" /></view>
