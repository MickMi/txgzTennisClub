.container {
  padding-top: 120rpx;
}
.hero {
  text-align: center;
  padding: 80rpx 0 40rpx;
}

.emoji {
  font-size: 100rpx;
}

.welcome {
  font-family: var(--font-display);
  font-size: 38rpx;
  font-weight: 600;
  margin: 20rpx 0 10rpx;
  color: var(--color-fg);
}

.label {
  font-size: 28rpx;
  color: var(--color-muted);
  margin-bottom: 16rpx;
}

.field {
  margin-bottom: 28rpx;
}

.input {
  height: 80rpx;
  background: var(--color-bg);
  border-radius: 0;
  padding: 0 24rpx;
  font-size: 30rpx;
}

.gender-group {
  display: flex;
  gap: 32rpx;
}

.gender-option {
  display: flex;
  align-items: center;
  padding: 16rpx 32rpx;
  background: var(--color-bg);
  border-radius: 0;
  font-size: 30rpx;
}

.gender-option.selected {
  background: var(--color-surface);
}

.tip {
  margin-top: 16rpx;
}

.submit {
  margin-top: 40rpx;
}

/* === 头像选择器 === */
.avatar-field {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.avatar-field .label {
  align-self: flex-start;
}

.avatar-picker {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.avatar-btn {
  padding: 0;
  margin: 0;
  background: none;
  border: none;
  line-height: 1;
  width: 160rpx;
  height: 160rpx;
}

.avatar-btn::after {
  display: none;
}

.avatar-preview {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  overflow: hidden;
  border: 3rpx solid var(--color-accent);
}

.avatar-img {
  width: 100%;
  height: 100%;
}

.avatar-placeholder {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  border: 2rpx dashed var(--color-border);
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-surface);
  color: var(--color-muted);
}

.avatar-tip {
  font-size: 22rpx;
}

.optional {
  font-size: 22rpx;
  color: var(--color-disabled);
  font-weight: normal;
}

/* === 隐私协议声明 === */
.privacy-section {
  margin: 32rpx 48rpx 0;
}

.privacy-check {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}

.privacy-check .checkbox {
  flex-shrink: 0;
  width: 36rpx;
  height: 36rpx;
  border: 2rpx solid var(--color-muted);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: var(--color-bg);
  margin-top: 4rpx;
}
.privacy-check .checkbox-icon {
  width: 22rpx;
  height: 22rpx;
}

.privacy-check .checkbox.checked {
  background: var(--color-emerald-deep);
  border-color: var(--color-emerald-deep);
}

.privacy-text {
  font-size: 26rpx;
  color: var(--color-muted);
  line-height: 1.5;
}

.privacy-link {
  color: var(--color-accent);
}

.privacy-summary {
  margin-top: 16rpx;
  padding: 20rpx 24rpx;
  background: var(--color-surface);
  border: 1rpx solid var(--color-border);
  font-size: 22rpx;
  color: var(--color-muted);
  line-height: 1.6;
}
