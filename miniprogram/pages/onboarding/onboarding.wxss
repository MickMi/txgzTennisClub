.hero {
  text-align: center;
  padding: 80rpx 0 40rpx;
}

.emoji {
  font-size: 100rpx;
}

.welcome {
  font-size: 38rpx;
  font-weight: 600;
  margin: 20rpx 0 10rpx;
  color: var(--color-fg);
}

.label {
  font-size: 28rpx;
  color: var(--color-muted);
  margin-bottom: 16rpx;
}

.field {
  margin-bottom: 28rpx;
}

.input {
  height: 80rpx;
  background: var(--color-bg);
  border-radius: 0;
  padding: 0 24rpx;
  font-size: 30rpx;
}

.gender-group {
  display: flex;
  gap: 32rpx;
}

.gender-option {
  display: flex;
  align-items: center;
  padding: 16rpx 32rpx;
  background: var(--color-bg);
  border-radius: 0;
  font-size: 30rpx;
}

.gender-option.selected {
  background: var(--color-surface);
}

.tip {
  margin-top: 16rpx;
}

.submit {
  margin-top: 40rpx;
}
