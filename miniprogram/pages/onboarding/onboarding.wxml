<view class="container">
  <view class="hero">
    <view class="emoji"><icon name="tennis" size="112" /></view>
    <view class="welcome">欢迎加入腾讯广州网球社</view>
    <view class="muted">首次进入需要登记一下基本信息</view>
  </view>

  <view class="card">
    <view class="field">
      <view class="label">企业微信名</view>
      <input
        class="input"
        placeholder="请填写你在企业微信中的姓名"
        value="{{wecomName}}"
        bindinput="onInput"
        maxlength="20"
      />
    </view>

    <view class="field">
      <view class="label">性别</view>
      <radio-group bindchange="onGenderChange" class="gender-group">
        <label class="gender-option {{gender === 'male' ? 'selected' : ''}}">
          <radio value="male" checked="{{gender === 'male'}}" color="#243a30" />
          <text>男</text>
        </label>
        <label class="gender-option {{gender === 'female' ? 'selected' : ''}}">
          <radio value="female" checked="{{gender === 'female'}}" color="#243a30" />
          <text>女</text>
        </label>
      </radio-group>
    </view>

    <view class="muted tip">用于在活动报名/比赛中标识你</view>
  </view>

  <button
    class="btn-primary submit"
    bindtap="onSubmit"
    disabled="{{submitting || !wecomName || !gender}}"
  >
    完成登记
  </button>
</view>
