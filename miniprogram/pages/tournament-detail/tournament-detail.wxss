/* === Tournament Detail — emerald-heritage === */

.page {
  background: var(--color-bg);
  min-height: 100vh;
  padding-bottom: 180rpx;
}

/* ========== Hero ========== */
.tournament-hero {
  position: relative;
  height: 640rpx;
  background: linear-gradient(168deg, #243a30 0%, #14201a 100%);
  color: var(--color-bg);
  overflow: hidden;
}

.tournament-hero::before {
  content: '';
  position: absolute;
  inset: 0;
  background-image: radial-gradient(rgba(255,255,255,0.04) 1px, transparent 1px);
  background-size: 6rpx 6rpx;
  pointer-events: none;
  mix-blend-mode: overlay;
}

.court-bg {
  position: absolute;
  inset: 0;
  opacity: 0.28;
  pointer-events: none;
}

.court-bg svg {
  width: 100%;
  height: 100%;
}

/* Top navigation */
.topnav {
  position: absolute;
  top: 94rpx;
  left: 0;
  right: 0;
  z-index: 30;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 32rpx;
}

.topnav .icon-btn {
  width: 72rpx;
  height: 72rpx;
  border: 1rpx solid rgba(245,239,224,0.22);
  background: rgba(20,28,22,0.32);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--color-bg);
  padding: 0;
  margin: 0;
  line-height: 1;
}

.topnav .icon-btn::after {
  display: none;
}

.topnav .actions {
  display: flex;
  gap: 16rpx;
}

/* Crest */
.crest {
  position: absolute;
  top: 220rpx;
  right: 48rpx;
  width: 104rpx;
  height: 104rpx;
  border: 1rpx solid var(--color-accent);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--color-accent);
  font-family: var(--font-display);
  font-size: 36rpx;
  font-weight: 500;
}

/* Masthead */
.hero-masthead {
  position: absolute;
  bottom: 44rpx;
  left: 48rpx;
  right: 48rpx;
}

.kicker {
  font-family: var(--font-mono);
  font-size: 20rpx;
  letter-spacing: 0.24em;
  text-transform: uppercase;
  color: var(--color-accent);
  display: inline-flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.kicker::before {
  content: '';
  display: inline-block;
  width: 32rpx;
  height: 1rpx;
  background: var(--color-accent);
}

.hero-title {
  font-family: var(--font-display);
  font-weight: 500;
  font-size: 60rpx;
  line-height: 1.05;
  letter-spacing: 0.005em;
  color: var(--color-bg);
}

.status-row {
  margin-top: 28rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  font-family: var(--font-mono);
  font-size: 21rpx;
  letter-spacing: 0.18em;
  color: rgba(248,244,232,0.78);
  text-transform: uppercase;
}

.status-pill {
  font-family: var(--font-mono);
  font-size: 19rpx;
  letter-spacing: 0.2em;
  padding: 8rpx 16rpx;
  text-transform: uppercase;
}

.status-signup {
  border: 1rpx solid var(--color-accent);
  color: var(--color-accent);
}

.status-group,
.status-knockout {
  background: var(--color-bg);
  color: var(--color-emerald-deep);
  border: 1rpx solid var(--color-bg);
}

.status-finished {
  border: 1rpx solid rgba(248,244,232,0.4);
  color: rgba(248,244,232,0.6);
}

/* ========== Tournament Meta ========== */
.tournament-meta {
  padding: 36rpx 48rpx 0;
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
}

.tournament-meta .cell {
  padding: 8rpx 28rpx;
  border-inline-start: 1rpx solid var(--color-border);
  line-height: 1.2;
}

.tournament-meta .cell:first-child {
  border-inline-start: 0;
  padding-inline-start: 0;
}

.tournament-meta .lbl {
  display: block;
  font-family: var(--font-mono);
  font-size: 18rpx;
  letter-spacing: 0.22em;
  text-transform: uppercase;
  color: var(--color-muted);
  margin-bottom: 10rpx;
}

.tournament-meta .val {
  font-family: var(--font-display);
  font-size: 30rpx;
  color: var(--color-fg);
  font-feature-settings: 'lnum','tnum';
  font-weight: 500;
}

.tournament-meta .em {
  font-style: normal;
  color: var(--color-muted);
  font-size: 22rpx;
  margin-inline-start: 6rpx;
}

/* ========== Content ========== */
.content {
  padding: 0 48rpx;
}

/* ========== Stage Tabs ========== */
.stage-tabs {
  display: flex;
  border-bottom: 1rpx solid var(--color-border);
  margin: 32rpx 0 24rpx;
}

.stage-tab {
  font-family: var(--font-mono);
  font-size: 21rpx;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--color-muted);
  padding: 20rpx 28rpx 20rpx 0;
  position: relative;
  margin-right: 36rpx;
}

.stage-tab.is-active {
  color: var(--color-fg);
}

.stage-tab.is-active::after {
  content: '';
  position: absolute;
  left: 0;
  right: 28rpx;
  bottom: -1rpx;
  height: 4rpx;
  background: var(--color-accent);
}

/* ========== Section Eyebrow ========== */
.section-eyebrow {
  border-top: var(--border-strong);
  padding-top: 22rpx;
  margin: 32rpx 0 16rpx;
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  font-family: var(--font-mono);
  font-size: 20rpx;
  letter-spacing: 0.22em;
  text-transform: uppercase;
  color: var(--color-fg);
}

.section-eyebrow .meta {
  color: var(--color-muted);
  font-size: 18rpx;
}

/* ========== Group Eyebrow ========== */
.group-eyebrow {
  border-top: var(--border-strong);
  padding-top: 22rpx;
  margin: 32rpx 0 16rpx;
  font-family: var(--font-mono);
  font-size: 20rpx;
  letter-spacing: 0.22em;
  text-transform: uppercase;
  color: var(--color-fg);
}

/* ========== Player List (signup) ========== */
.player-list {
  margin-top: 8rpx;
}

.player-row {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: var(--border-hairline);
}

.player-row:last-child {
  border-bottom: none;
}

.player-rank {
  width: 48rpx;
  font-family: var(--font-display);
  font-size: 26rpx;
  font-feature-settings: 'tnum','lnum';
  color: var(--color-muted);
  text-align: center;
}

.player-info {
  flex: 1;
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  min-width: 0;
}

.player-name {
  font-size: 28rpx;
  color: var(--color-fg);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.player-pts {
  font-family: var(--font-mono);
  font-size: 20rpx;
  color: var(--color-muted);
  letter-spacing: 0.08em;
}

.player-rating {
  font-family: var(--font-mono);
  font-size: 20rpx;
  color: var(--color-muted);
  padding: 4rpx 12rpx;
  border: 1rpx solid var(--color-border);
}

.empty-hint {
  font-family: var(--font-mono);
  font-size: 22rpx;
  letter-spacing: 0.12em;
  color: var(--color-muted);
  text-align: center;
  padding: 40rpx 0;
}

/* ========== Draw Settings ========== */
.draw-section {
  margin-top: 32rpx;
}

.draw-setting {
  margin-top: 12rpx;
}

.draw-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 0;
  border-bottom: var(--border-hairline);
}

.draw-row:last-of-type {
  border-bottom: none;
}

.draw-label {
  font-size: 28rpx;
  color: var(--color-fg);
}

.draw-picker {
  font-size: 28rpx;
  color: var(--color-fg);
  padding: 8rpx 20rpx;
  background: var(--color-surface);
  font-family: var(--font-mono);
}

.draw-input {
  width: 120rpx;
  height: 60rpx;
  text-align: center;
  font-size: 28rpx;
  background: var(--color-surface);
  border: 1rpx solid var(--color-border);
}

.draw-hint {
  margin-top: 16rpx;
  font-family: var(--font-mono);
  font-size: 22rpx;
  color: var(--color-muted);
  letter-spacing: 0.08em;
  text-align: center;
}

/* ========== Group Block ========== */
.group-block {
  margin-bottom: 8rpx;
}

.standings {
  margin-bottom: 20rpx;
  border: 1rpx solid var(--color-border);
  overflow: hidden;
}

.standings-header {
  display: flex;
  background: var(--color-surface);
  padding: 14rpx 16rpx;
  font-size: 18rpx;
  color: var(--color-muted);
  font-weight: 500;
  font-family: var(--font-mono);
  letter-spacing: 0.1em;
  text-transform: uppercase;
}

.standings-row {
  display: flex;
  padding: 16rpx 16rpx;
  border-top: var(--border-hairline);
  font-size: 26rpx;
}

.standings-row.advance {
  background: var(--color-surface);
}

.st-rank {
  width: 50rpx;
  text-align: center;
  font-family: var(--font-display);
  font-feature-settings: 'tnum','lnum';
}

.st-name {
  flex: 1;
}

.st-stat {
  width: 60rpx;
  text-align: center;
  font-family: var(--font-display);
  font-feature-settings: 'tnum','lnum';
}

/* ========== Match List ========== */
.match-list {
  margin-top: 8rpx;
}

.match-row {
  padding: 18rpx 0;
  border-bottom: var(--border-hairline);
}

.match-row:last-child {
  border-bottom: none;
}

.match-players {
  display: flex;
  align-items: center;
  font-size: 28rpx;
}

.match-name {
  max-width: 200rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: var(--color-fg);
}

.match-vs {
  margin: 0 16rpx;
  color: var(--color-muted);
  font-family: var(--font-display);
  font-style: italic;
  font-size: 24rpx;
}

.winner-name {
  color: var(--color-accent);
  font-weight: 600;
}

.match-score {
  font-family: var(--font-mono);
  font-size: 22rpx;
  color: var(--color-muted);
  margin-top: 8rpx;
  letter-spacing: 0.04em;
}

.match-action {
  font-family: var(--font-mono);
  font-size: 22rpx;
  color: var(--color-accent);
  margin-top: 8rpx;
  letter-spacing: 0.12em;
  text-transform: uppercase;
}

/* ========== Score Edit ========== */
.score-edit {
  margin-top: 16rpx;
  padding: 20rpx;
  background: var(--color-surface);
  border: 1rpx solid var(--color-border);
}

.score-edit-simple {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
}

.score-input {
  flex: 1;
  height: 72rpx;
  background: var(--color-bg);
  border: 1rpx solid var(--color-border);
  text-align: center;
  font-size: 32rpx;
  font-family: var(--font-display);
  font-feature-settings: 'tnum','lnum';
}

.dash {
  width: 48rpx;
  text-align: center;
  color: var(--color-muted);
  font-size: 28rpx;
}

.score-btns {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
}

.flex1 {
  flex: 1;
}

/* ========== Knockout ========== */
.knockout-block {
  margin-top: 8rpx;
}

.ko-round {
  margin-bottom: 24rpx;
}

.ko-round:last-child {
  margin-bottom: 0;
}

.ko-round-title {
  font-family: var(--font-mono);
  font-size: 20rpx;
  letter-spacing: 0.18em;
  color: var(--color-muted);
  text-transform: uppercase;
  padding: 12rpx 0;
  border-bottom: var(--border-hairline);
  margin-bottom: 4rpx;
}

/* ========== Admin Action ========== */
.admin-action {
  margin-top: 32rpx;
  padding-top: 32rpx;
  border-top: var(--border-hairline);
}

/* ========== Champion ========== */
.champion-block {
  text-align: center;
  padding: 60rpx 0;
  border-top: var(--border-strong);
  margin-top: 32rpx;
}

.champion-text {
  font-family: var(--font-display);
  font-size: 32rpx;
  font-weight: 500;
  color: var(--color-accent);
  margin-top: 20rpx;
}

/* ========== Tab 1: 签表 — Group Draw ========== */
.group-draw {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
  margin-top: 12rpx;
}

.draw-group {
  background: var(--color-surface);
  padding: 20rpx;
  border: 1rpx solid var(--color-border);
}

.draw-group-title {
  font-family: var(--font-mono);
  font-size: 18rpx;
  letter-spacing: 0.2em;
  font-weight: 500;
  color: var(--color-fg);
  text-transform: uppercase;
  margin-bottom: 14rpx;
  text-align: center;
}

.draw-player {
  font-size: 26rpx;
  padding: 10rpx 0;
  border-bottom: var(--border-hairline);
  color: var(--color-fg);
}

.draw-player:last-child {
  border-bottom: none;
}

.draw-player.seed {
  font-weight: 500;
}

.seed-badge {
  color: var(--color-accent);
  font-size: 20rpx;
  margin-right: 8rpx;
  font-family: var(--font-mono);
}

/* ========== Tab 1: 签表 — Bracket ========== */
.bracket-scroll {
  width: 100%;
  white-space: nowrap;
  margin-top: 12rpx;
}

.bracket {
  display: inline-flex;
  align-items: flex-start;
  padding: 16rpx 0;
  min-width: 100%;
}

.bracket-round {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-width: 240rpx;
  margin-right: 12rpx;
}

.bracket-round:last-child {
  margin-right: 0;
}

.bracket-round-title {
  font-family: var(--font-mono);
  font-size: 18rpx;
  letter-spacing: 0.2em;
  color: var(--color-muted);
  text-transform: uppercase;
  margin-bottom: 16rpx;
  font-weight: 500;
}

.bracket-matches {
  display: flex;
  flex-direction: column;
  justify-content: space-around;
  flex: 1;
  width: 100%;
}

.bracket-match {
  background: var(--color-surface);
  border: 1rpx solid var(--color-border);
  margin-bottom: 16rpx;
  overflow: hidden;
}

.bracket-slot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 20rpx;
  border-bottom: var(--border-hairline);
}

.bracket-slot:last-child {
  border-bottom: none;
}

.bracket-slot.slot-win {
  background: var(--color-bg);
}

.bracket-name {
  font-size: 24rpx;
  color: var(--color-fg);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 160rpx;
}

.bracket-score {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--color-accent);
  margin-left: 8rpx;
  font-family: var(--font-display);
  font-feature-settings: 'tnum','lnum';
}

/* ========== Tournament CTA Bar ========== */
.tournament-cta-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 38;
  background: var(--color-surface);
  border-top: 1rpx solid var(--color-border);
  padding: 28rpx 40rpx 60rpx;
  display: grid;
  grid-template-columns: auto 1fr;
  gap: 28rpx;
  align-items: center;
}

.tournament-cta-bar .status {
  line-height: 1.1;
}

.tournament-cta-bar .num {
  font-family: var(--font-display);
  font-size: 44rpx;
  color: var(--color-fg);
  font-feature-settings: 'tnum','lnum';
  font-weight: 500;
}

.tournament-cta-bar .num-em {
  font-style: normal;
  color: var(--color-muted);
  font-size: 28rpx;
}

.tournament-cta-bar .lbl {
  display: block;
  font-family: var(--font-mono);
  font-size: 18rpx;
  letter-spacing: 0.2em;
  color: var(--color-muted);
  text-transform: uppercase;
  margin-top: 10rpx;
}

/* ========== CTA Buttons ==========
   修复：之前 height + line-height: 100rpx 导致两行文字（如"小组赛
   结束，进入淘汰赛"）被裁切。改用 min-height + line-height: 1.4 +
   上下 padding 自然撑高，box-sizing 防止微信 button 默认 padding 溢出。 */
.cta-primary {
  appearance: none;
  -webkit-appearance: none;
  background: var(--color-emerald-deep);
  color: var(--color-bg);
  border: 1rpx solid var(--color-emerald-deep);
  padding: 22rpx 36rpx;
  font-family: var(--font-body);
  font-weight: 500;
  font-size: 30rpx;
  line-height: 1.4;
  letter-spacing: 0.06em;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  gap: 12rpx;
  border-radius: 0;
  min-height: 100rpx;
  box-sizing: border-box;
  white-space: normal;
  word-break: break-word;
}

.cta-primary::after {
  content: '';
  position: absolute;
  left: 28rpx;
  right: 28rpx;
  bottom: 10rpx;
  height: 1rpx;
  background: var(--color-accent);
  opacity: 0.85;
}

.cta-cancel {
  background: transparent;
  border: 1rpx solid var(--color-fg);
  color: var(--color-fg);
}

.cta-cancel::after {
  display: none;
}

.cta-inline,
.draw-btn {
  margin-top: 32rpx;
  width: 100%;
}

/* Danger zone — emerald-heritage 风格的危险操作 */
.danger-zone {
  margin-top: 80rpx;
  padding-top: 32rpx;
  border-top: 1rpx solid var(--color-border);
}
.danger-action {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 0;
  border: 1rpx solid var(--color-border);
  border-left: 3rpx solid var(--color-accent);
  padding-left: 24rpx;
  padding-right: 24rpx;
}
.danger-action text:first-child {
  font-family: var(--font-display);
  font-size: 28rpx;
  color: var(--color-fg);
}
.danger-meta {
  font-family: var(--font-mono);
  font-size: 20rpx;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--color-accent);
}
