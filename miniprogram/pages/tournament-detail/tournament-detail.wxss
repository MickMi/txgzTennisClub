/* Tab 切换 */
.tab-bar {
  display: flex;
  background: var(--color-bg);
  border-radius: 0;
  margin-bottom: 20rpx;
  overflow: hidden;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 22rpx 0;
  font-size: 28rpx;
  color: var(--color-muted);
  position: relative;
}

.tab-active {
  color: var(--color-fg);
  font-weight: 600;
}

.tab-active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 25%;
  width: 50%;
  height: 4rpx;
  background: var(--color-accent);
  border-radius: 0;
}

.big {
  font-family: var(--font-display);
  font-size: 38rpx;
  margin-bottom: 16rpx;
}

.meta {
  color: var(--color-muted);
  margin-top: 10rpx;
  font-size: 28rpx;
}

.handicap-rule {
  color: var(--color-accent);
  font-weight: 500;
}

.section-title {
  font-family: var(--font-display);
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.status-badge {
  display: inline-block;
  margin-top: 16rpx;
  padding: 6rpx 20rpx;
  border-radius: 0;
  font-size: 24rpx;
  font-weight: 500;
  font-family: var(--font-mono);
  border: 1rpx solid currentColor;
  background: transparent;
}

.status-badge.signup {
  color: var(--color-accent);
}

.status-badge.group {
  color: var(--color-accent);
}

.status-badge.knockout {
  color: var(--color-danger);
}

.status-badge.finished {
  color: var(--color-muted);
}

/* 报名列表 */
.player-row {
  display: flex;
  align-items: center;
  padding: 12rpx 0;
  border-bottom: var(--border-hairline);
}

.player-row:last-child {
  border-bottom: none;
}

.player-gender {
  font-size: 28rpx;
  margin-right: 8rpx;
  color: var(--color-muted);
}

.player-name {
  flex: 1;
  font-size: 28rpx;
}

.player-pts {
  font-size: 22rpx;
  color: var(--color-fg);
  font-family: var(--font-display);
  font-feature-settings: 'tnum','lnum';
  margin-right: 12rpx;
}

.player-rating {
  font-size: 22rpx;
  padding: 2rpx 10rpx;
  background: transparent;
  color: var(--color-muted);
  border-radius: 0;
  font-family: var(--font-mono);
}

.actions {
  margin-top: 16rpx;
}

/* 抽签设置 */
.draw-setting {
  margin-top: 12rpx;
}

.draw-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14rpx 0;
  border-bottom: var(--border-hairline);
}

.draw-row:last-of-type {
  border-bottom: none;
}

.draw-label {
  font-size: 28rpx;
  color: var(--color-fg);
}

.draw-picker {
  font-size: 28rpx;
  color: var(--color-fg);
  padding: 8rpx 20rpx;
  background: var(--color-bg);
  border-radius: 0;
  font-family: var(--font-mono);
}

.draw-input {
  width: 120rpx;
  height: 60rpx;
  text-align: center;
  font-size: 28rpx;
  background: var(--color-bg);
  border-radius: 0;
}

.draw-hint {
  margin-top: 12rpx;
  font-size: 24rpx;
  text-align: center;
}

/* 排名表 */
.standings {
  margin-bottom: 20rpx;
  border: 1rpx solid var(--color-border);
  border-radius: 0;
  overflow: hidden;
}

.standings-header {
  display: flex;
  background: var(--color-bg);
  padding: 12rpx 16rpx;
  font-size: 22rpx;
  color: var(--color-muted);
  font-weight: 500;
  font-family: var(--font-mono);
}

.standings-row {
  display: flex;
  padding: 14rpx 16rpx;
  border-top: var(--border-hairline);
  font-size: 26rpx;
}

.standings-row.advance {
  background: var(--color-surface);
}

.st-rank {
  width: 50rpx;
  text-align: center;
  font-family: var(--font-display);
  font-feature-settings: 'tnum','lnum';
}

.st-name {
  flex: 1;
}

.st-stat {
  width: 60rpx;
  text-align: center;
  font-family: var(--font-display);
  font-feature-settings: 'tnum','lnum';
}

/* 对阵列表 */
.match-list {
  margin-top: 16rpx;
}

.match-row {
  padding: 16rpx 0;
  border-bottom: var(--border-hairline);
}

.match-row:last-child {
  border-bottom: none;
}

.match-players {
  display: flex;
  align-items: center;
  font-size: 28rpx;
}

.match-vs {
  margin: 0 16rpx;
  color: var(--color-disabled);
  font-size: 24rpx;
}

.winner-name {
  color: var(--color-success);
  font-weight: 600;
}

.match-score {
  font-size: 24rpx;
  color: var(--color-muted);
  margin-top: 6rpx;
}

.match-action {
  font-size: 24rpx;
  color: var(--color-accent);
  margin-top: 8rpx;
}

/* 录分编辑 */
.score-edit {
  margin-top: 12rpx;
  padding: 16rpx;
  background: var(--color-bg);
  border-radius: 0;
}

.score-edit-simple {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12rpx;
}

.score-edit-row {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.set-label {
  width: 100rpx;
  font-size: 24rpx;
  color: var(--color-muted);
}

.score-input {
  flex: 1;
  height: 60rpx;
  background: var(--color-surface);
  border: 1rpx solid var(--color-border);
  border-radius: 0;
  text-align: center;
  font-size: 28rpx;
}

.dash {
  width: 40rpx;
  text-align: center;
  color: var(--color-disabled);
}

.btns {
  margin-top: 16rpx;
}

.flex1 {
  flex: 1;
}

/* 淘汰赛 */
.ko-round {
  margin-bottom: 24rpx;
}

.ko-round:last-child {
  margin-bottom: 0;
}

.ko-round-title {
  font-size: 26rpx;
  color: var(--color-muted);
  font-weight: 500;
  padding: 8rpx 0;
  border-bottom: var(--border-hairline);
  margin-bottom: 12rpx;
}

/* 冠军 */
.champion-card {
  text-align: center;
  padding: 40rpx;
}

.champion-icon {
  font-size: 80rpx;
}

.champion-text {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-accent);
  margin-top: 16rpx;
}

/* ========== 签表样式 ========== */

/* 小组分组 */
.group-draw {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.draw-group {
  flex: 1;
  min-width: 200rpx;
  background: var(--color-surface);
  border-radius: 0;
  padding: 16rpx;
  border: 1rpx solid var(--color-border);
}

.draw-group-title {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--color-fg);
  margin-bottom: 12rpx;
  text-align: center;
  font-family: var(--font-mono);
}

.draw-player {
  font-size: 26rpx;
  padding: 8rpx 0;
  border-bottom: var(--border-hairline);
}

.draw-player:last-child {
  border-bottom: none;
}

.draw-player.seed {
  font-weight: 500;
}

.seed-badge {
  color: var(--color-accent);
  font-size: 22rpx;
  margin-right: 6rpx;
  font-family: var(--font-mono);
}

/* 淘汰赛 Bracket */
.bracket-card {
  padding-bottom: 12rpx;
}

.bracket-scroll {
  width: 100%;
  white-space: nowrap;
}

.bracket {
  display: inline-flex;
  align-items: flex-start;
  padding: 16rpx 0;
  min-width: 100%;
}

.bracket-round {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-width: 240rpx;
  margin-right: 12rpx;
}

.bracket-round:last-child {
  margin-right: 0;
}

.bracket-round-title {
  font-size: 22rpx;
  color: var(--color-muted);
  margin-bottom: 16rpx;
  font-weight: 500;
  font-family: var(--font-mono);
}

.bracket-matches {
  display: flex;
  flex-direction: column;
  justify-content: space-around;
  flex: 1;
  width: 100%;
}

.bracket-match {
  background: var(--color-surface);
  border: 1rpx solid var(--color-border);
  border-radius: 0;
  margin-bottom: 16rpx;
  overflow: hidden;
}

.bracket-slot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14rpx 16rpx;
  border-bottom: var(--border-hairline);
}

.bracket-slot:last-child {
  border-bottom: none;
}

.bracket-slot.slot-win {
  background: var(--color-bg);
}

.bracket-name {
  font-size: 24rpx;
  color: var(--color-fg);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 160rpx;
}

.bracket-score {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--color-accent);
  margin-left: 8rpx;
  font-family: var(--font-display);
  font-feature-settings: 'tnum','lnum';
}
