<view class="page" style="background: {{currentStyle.bg}};">
  <!-- 隐私授权弹窗（保存海报到相册需要） -->
  <privacy-popup />
  <!-- 顶部导航：padding-right 用 capsuleGap 让出胶囊禁入区，避免 title/右侧元素被胶囊盖住 -->
  <view class="topnav" style="padding-top: {{navTop}}rpx; padding-right: {{capsuleGap}}rpx;">
    <view class="icon-btn" bindtap="goBack">
      <image src="/assets/icons/back.svg" />
    </view>
    <view class="topnav-title">{{posterType === 'report' ? '赛事战报' : '我的战绩卡'}}</view>
    <view class="topnav-spacer"></view>
  </view>

  <!-- 海报预览区 -->
  <view class="preview-wrap">
    <view class="preview-frame" wx:if="{{!loading}}" style="aspect-ratio: {{previewRatio || (750/1600)}};">
      <canvas type="2d" id="posterCanvas" class="canvas-el"></canvas>
    </view>
    <view wx:else class="preview-loading muted">
      <text>正在生成海报…</text>
    </view>
  </view>

  <!-- 风格选择条（横滚 chip） -->
  <scroll-view class="style-bar" scroll-x scroll-with-animation>
    <view class="style-bar-inner">
      <view
        wx:for="{{styles}}"
        wx:key="id"
        class="style-chip {{currentStyleIndex === index ? 'is-active' : ''}}"
        bindtap="switchStyle"
        data-index="{{index}}"
      >
        <view class="chip-dot" style="background: {{item.accent}};"></view>
        <text class="chip-name">{{item.name}}</text>
      </view>
    </view>
  </scroll-view>

  <!-- 头像模式切换 — 与 .style-chip 完全同款：纯文字 pill -->
  <view class="avatar-mode-bar">
    <view class="avatar-mode-tabs">
      <view class="avatar-mode-tab {{avatarMode === 'photo' ? 'is-active' : ''}}" data-mode="photo" bindtap="switchAvatarMode">照片</view>
      <view class="avatar-mode-tab {{avatarMode === 'initial' ? 'is-active' : ''}}" data-mode="initial" bindtap="switchAvatarMode">首字母</view>
    </view>
  </view>

  <!-- 底部操作栏 — 不用全局 cta-primary/btn-default，用页内成对变体确保等高 -->
  <view class="action-bar">
    <button class="action-btn" bindtap="onSave" disabled="{{loading || !posterReady}}">
      <text>保存到相册</text>
    </button>
    <button class="action-btn action-btn--primary" bindtap="onShare" disabled="{{loading || !posterReady}}">
      <text>发送给朋友</text>
    </button>
  </view>
</view>
