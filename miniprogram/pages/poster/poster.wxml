<view class="page" style="background: {{currentStyle.bg}};">
  <!-- 顶部导航
       padding-right 用 capsuleGap 让出胶囊禁入区，避免 title/右侧元素被胶囊盖住 -->
  <view class="topnav" style="padding-top: {{navTop}}rpx; padding-right: {{capsuleGap}}rpx;">
    <view class="icon-btn" bindtap="goBack">
      <image src="/assets/icons/back.svg" />
    </view>
    <view class="topnav-title">{{posterType === 'report' ? '赛事战报' : '我的战绩卡'}}</view>
    <view class="topnav-spacer"></view>
  </view>

  <!-- 海报预览区 -->
  <view class="preview-wrap">
    <view class="preview-frame" wx:if="{{!loading}}">
      <canvas type="2d" id="posterCanvas" class="canvas-el"></canvas>
    </view>
    <view wx:else class="preview-loading muted">
      <text>正在生成海报…</text>
    </view>
  </view>

  <!-- 风格选择条（横滚 chip） -->
  <scroll-view class="style-bar" scroll-x scroll-with-animation>
    <view class="style-bar-inner">
      <view
        wx:for="{{styles}}"
        wx:key="id"
        class="style-chip {{currentStyleIndex === index ? 'is-active' : ''}}"
        bindtap="switchStyle"
        data-index="{{index}}"
      >
        <view class="chip-dot" style="background: {{item.accent}};"></view>
        <text class="chip-name">{{item.name}}</text>
      </view>
    </view>
  </scroll-view>

  <!-- 底部操作栏 -->
  <view class="action-bar">
    <button class="btn-default action-btn" bindtap="onSave" disabled="{{loading || !posterReady}}">
      <text>保存到相册</text>
    </button>
    <button class="cta-primary action-btn" bindtap="onShare" disabled="{{loading || !posterReady}}">
      <text>发送给朋友</text>
    </button>
  </view>
</view>
