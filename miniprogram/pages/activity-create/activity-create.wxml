<view class="container">
  <!-- 返回按钮 -->
  <view class="page-back" style="top: {{navTop}}rpx;" bindtap="goBack">
    <image src="/assets/icons/back.svg" />
  </view>

  <!-- Masthead -->
  <view class="masthead">
    <view class="masthead-left">
      <view class="wordmark">{{isEdit ? '编辑活动' : '创建活动'}}</view>
      <view class="wordmark-caption">{{isEdit ? 'EDIT ACTIVITY' : 'NEW ACTIVITY'}}</view>
    </view>
    <view class="masthead-actions">
    </view>
  </view>

  <view class="form-content">
    <view class="form-row">
      <text class="form-label">TITLE · 活动标题 <text class="required">*</text></text>
      <input class="form-input" placeholder="例如：周三晚训"
        value="{{form.title}}" data-key="title" bindinput="onInput" maxlength="40" />
    </view>

    <view class="form-row">
      <text class="form-label">DATE · 日期 <text class="required">*</text></text>
      <picker mode="date" value="{{form.date}}" bindchange="onDateChange">
        <view class="form-picker">{{form.date || '请选择'}}</view>
      </picker>
    </view>

    <view class="form-row">
      <text class="form-label">TIME · 时间 <text class="required">*</text></text>
      <picker mode="time" value="{{form.time}}" bindchange="onTimeChange">
        <view class="form-picker">{{form.time || '请选择'}}</view>
      </picker>
    </view>

    <view class="form-row">
      <text class="form-label">LOCATION · 地点 <text class="required">*</text></text>
      <input class="form-input" placeholder="例如：T.I.T 球场 2 号"
        value="{{form.location}}" data-key="location" bindinput="onInput" maxlength="50" />
    </view>

    <view class="form-row">
      <text class="form-label">CAPACITY · 人数上限</text>
      <input class="form-input" type="number" placeholder="0（不限填 0）"
        value="{{form.maxPeople}}" data-key="maxPeople" bindinput="onInput" />
    </view>

    <view class="form-row">
      <text class="form-label">NOTE · 备注</text>
      <textarea class="form-textarea" placeholder="自带球拍/费用 AA 等"
        value="{{form.note}}" data-key="note" bindinput="onInput" maxlength="200" />
    </view>
  </view>

  <view class="form-cta-bar">
    <button class="cta-primary" bindtap="onSubmit" disabled="{{submitting}}">
      {{isEdit ? '保存修改' : '创建活动'}}
    </button>
  </view>
</view>
