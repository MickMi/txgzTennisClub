.field {
  margin-bottom: 28rpx;
}

.label {
  font-size: 26rpx;
  color: var(--color-muted);
  margin-bottom: 12rpx;
}

.input, .picker {
  height: 80rpx;
  background: var(--color-bg);
  border-radius: 0;
  padding: 0 24rpx;
  line-height: 80rpx;
  font-size: 30rpx;
}

.textarea {
  width: 100%;
  min-height: 160rpx;
  background: var(--color-bg);
  border-radius: 0;
  padding: 20rpx 24rpx;
  font-size: 30rpx;
  box-sizing: border-box;
}

.submit {
  margin-top: 30rpx;
}
