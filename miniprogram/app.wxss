/* === emerald-heritage Design Tokens === */
page {
  /* 色板 */
  --color-bg:        #f1ece0;
  --color-surface:   #f8f4e8;
  --color-border:    #ddd6c4;
  --color-fg:        #1f2e22;
  --color-muted:     #5d6e63;
  --color-disabled:  #b6b29f;
  --color-emerald-deep: #243a30;
  --color-emerald:      #2d5443;
  --color-accent:    #b87a36;
  --color-success:   #2d5443;
  --color-warning:   #b87a36;
  --color-danger:    #8b3a3a;
  --color-info:      #5d6e63;

  /* 字体 */
  --font-display: 'Iowan Old Style', 'Charter', 'Source Han Serif SC', 'Songti SC', Georgia, serif;
  --font-body: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Hiragino Sans GB', 'Segoe UI', system-ui, sans-serif;
  --font-mono: ui-monospace, 'SF Mono', 'JetBrains Mono', Menlo, monospace;

  /* 字号阶 */
  --text-display-xl: 160rpx;
  --text-display-lg: 68rpx;
  --text-display-md: 48rpx;
  --text-display-sm: 36rpx;
  --text-body-lg: 30rpx;
  --text-body: 28rpx;
  --text-body-sm: 24rpx;
  --text-mono-md: 22rpx;
  --text-mono-sm: 20rpx;

  /* 间距阶 */
  --space-1:  8rpx;
  --space-2:  16rpx;
  --space-3:  24rpx;
  --space-4:  32rpx;
  --space-5:  48rpx;
  --space-6:  64rpx;
  --space-7:  96rpx;

  /* 圆角 */
  --radius-none: 0;
  --radius-sm:   4rpx;
  --radius-md:   8rpx;
  --radius-lg:   16rpx;
  --radius-pill: 999rpx;

  /* 边线 */
  --border-hairline: 1rpx solid var(--color-border);
  --border-strong:   1rpx solid var(--color-fg);
  --border-accent:   2rpx solid var(--color-accent);

  /* 阴影（仅模态用） */
  --shadow-modal: 0 8rpx 32rpx rgba(20, 30, 25, 0.18);

  /* 基础样式 */
  background: var(--color-bg);
  font-size: var(--text-body);
  color: var(--color-fg);
  font-family: var(--font-body);
}

/* === 布局基础 === */
.container {
  padding: 0 0 160rpx;
  box-sizing: border-box;
}

/* === §5.1 卡片（边线分隔，无阴影无圆角） === */
.card {
  background: var(--color-bg);
  border-top: var(--border-strong);
  padding: var(--space-4) var(--space-5);
  margin: 0;
  display: block;
}
.card + .card {
  border-top: var(--border-hairline);
}
.card-eyebrow {
  font-family: var(--font-mono);
  font-size: var(--text-mono-sm);
  text-transform: uppercase;
  color: var(--color-accent);
  margin-bottom: 12rpx;
}
.card-title {
  font-family: var(--font-display);
  font-size: var(--text-display-md);
  line-height: 1.2;
  color: var(--color-fg);
  margin-bottom: 16rpx;
}
.card-meta {
  display: flex;
  gap: 24rpx;
  color: var(--color-muted);
  font-size: var(--text-body-sm);
}
.card-foot {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 24rpx;
  font-family: var(--font-mono);
  font-size: var(--text-mono-md);
  text-transform: uppercase;
  color: var(--color-fg);
}
.card-arrow {
  color: var(--color-accent);
}

/* === §5.2 Meta 行 === */
.meta-row {
  display: grid;
  grid-template-columns: 44rpx 1fr auto;
  column-gap: 28rpx;
  align-items: center;
  padding: 26rpx 0;
  border-bottom: var(--border-hairline);
}
.meta-row:last-child {
  border-bottom: none;
}
.meta-icon {
  width: 36rpx;
  height: 36rpx;
  color: var(--color-muted);
}
.meta-label {
  display: block;
  font-family: var(--font-mono);
  font-size: 19rpx;
  text-transform: uppercase;
  color: var(--color-muted);
  margin-bottom: 6rpx;
}
.meta-value {
  font-size: 29rpx;
  line-height: 1.35;
  color: var(--color-fg);
  font-feature-settings: 'tnum','lnum';
}
.meta-badge {
  font-family: var(--font-mono);
  font-size: var(--text-mono-sm);
  color: var(--color-accent);
  letter-spacing: 0.12em;
  text-transform: uppercase;
  border: 1rpx solid var(--color-accent);
  padding: 8rpx 16rpx;
}

/* === §5.3 巨幅日期戳 === */
.datestamp {
  border-top: var(--border-strong);
  border-bottom: var(--border-strong);
  padding: 36rpx 0;
  margin: 48rpx 0;
  display: grid;
  grid-template-columns: auto 1fr;
  column-gap: 44rpx;
  align-items: center;
}
.datestamp-day {
  font-family: var(--font-display);
  font-size: var(--text-display-xl);
  line-height: 0.85;
  color: var(--color-fg);
  font-weight: 500;
  letter-spacing: -0.02em;
  font-feature-settings: 'lnum', 'tnum';
}
.datestamp-month {
  display: block;
  font-size: var(--text-body-sm);
  line-height: 1;
  margin-top: 20rpx;
  color: var(--color-muted);
  font-family: var(--font-mono);
  text-transform: uppercase;
  letter-spacing: 0.22em;
  font-feature-settings: normal;
}
.datestamp-right {
  align-self: stretch;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  padding: 8rpx 0;
}
.datestamp-when {
  font-family: var(--font-display);
  font-size: var(--text-display-sm);
  line-height: 1.25;
  color: var(--color-fg);
}
.datestamp-when em {
  font-style: normal;
  color: var(--color-accent);
}
.datestamp-session {
  font-family: var(--font-mono);
  font-size: var(--text-mono-sm);
  color: var(--color-muted);
  text-transform: uppercase;
  margin-top: 24rpx;
}

/* === §5.4 容量进度 === */
.capacity {
  display: grid;
  grid-template-columns: 1fr auto;
  align-items: end;
  gap: 8rpx;
}
.capacity-num {
  font-family: var(--font-display);
  font-size: 56rpx;
  line-height: 1;
  color: var(--color-fg);
  font-feature-settings: 'tnum', 'lnum';
}
.capacity-num em {
  font-style: normal;
  color: var(--color-muted);
  font-size: 36rpx;
}
.capacity-meta {
  font-family: var(--font-mono);
  font-size: 19rpx;
  letter-spacing: 0.2em;
  color: var(--color-muted);
  text-transform: uppercase;
}
.capacity-bar {
  grid-column: 1 / -1;
  margin-top: 20rpx;
  height: 4rpx;
  background: var(--color-border);
  position: relative;
}
.capacity-bar::after {
  content: '';
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: var(--fill, 0%);
  background: var(--color-accent);
}

/* === §5.5 玩家小卡 === */
.player {
  display: grid;
  grid-template-columns: 60rpx 1fr;
  gap: 20rpx;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: var(--border-hairline);
  min-width: 0;
}
.player:last-child {
  border-bottom: none;
}
.avatar {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: var(--color-surface);
  border: 1rpx solid var(--color-border);
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: var(--font-display);
  font-size: 26rpx;
  color: var(--color-fg);
  flex-shrink: 0;
  overflow: hidden;
}
.avatar .avatar-img {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}
.player[data-gender='female'] .avatar {
  border-color: var(--color-accent);
  color: var(--color-accent);
}
.player-name {
  font-size: 27rpx;
  color: var(--color-fg);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  display: block;
}
.player-rating {
  font-family: var(--font-mono);
  font-size: 19rpx;
  letter-spacing: 0.05em;
  color: var(--color-muted);
  margin-top: 4rpx;
  display: block;
  font-feature-settings: 'tnum','lnum';
}
.player-rating.unrated {
  color: var(--color-disabled);
}

/* === §5.6 主 CTA 按钮 ===
   关键防御：用 min-height 让文字多行时自然撑高；line-height 1.4 不依赖
   外部高度；box-sizing 让 padding 计入宽度（防止微信 <button> 默认溢出） */
.cta-primary {
  width: 100%;
  background: var(--color-emerald-deep);
  color: var(--color-bg);
  border: 1rpx solid var(--color-emerald-deep);
  padding: 22rpx 36rpx;
  font-family: var(--font-body);
  font-weight: 500;
  font-size: var(--text-body-lg);
  line-height: 1.4;
  border-radius: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  gap: 24rpx;
  min-height: 100rpx;
  box-sizing: border-box;
  white-space: normal;
  word-break: break-word;
  position: relative;
}
.cta-primary::after {
  content: '';
  position: absolute;
  left: 28rpx;
  right: 28rpx;
  bottom: 10rpx;
  height: 1rpx;
  background: var(--color-accent);
  opacity: 0.85;
}
.cta-primary[disabled] {
  background: var(--color-border);
  border-color: var(--color-border);
  color: var(--color-muted);
}
.cta-primary[disabled]::after {
  display: none;
}

/* === §5.7 标签/徽章 === */
.tag {
  display: inline-block;
  font-family: var(--font-mono);
  font-size: var(--text-mono-sm);
  letter-spacing: 0.18em;
  text-transform: uppercase;
  padding: 6rpx 14rpx;
  border: 1rpx solid currentColor;
  border-radius: 0;
  background: transparent;
}
.tag--open { color: var(--color-emerald-deep); }
.tag--closed { color: var(--color-muted); }
.tag--accent { color: var(--color-accent); }
.tag--danger { color: var(--color-danger); }
/* 兼容旧类名 */
.tag-gray { color: var(--color-muted); border-color: var(--color-muted); background: transparent; }

/* === §5.8 Section eyebrow === */
.section-eyebrow {
  border-top: var(--border-strong);
  padding-top: 22rpx;
  margin-bottom: 32rpx;
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  font-family: var(--font-mono);
  font-size: var(--text-mono-sm);
  text-transform: uppercase;
  color: var(--color-fg);
}
.section-eyebrow .meta {
  color: var(--color-muted);
  font-size: 18rpx;
  letter-spacing: 0.2em;
}

/* === §5.9 数字编号列表 === */
.rules {
  list-style: none;
  padding: 0;
  margin: 0;
}
.rule-item {
  display: grid;
  grid-template-columns: 60rpx 1fr;
  column-gap: 28rpx;
  padding: 24rpx 0;
  border-bottom: var(--border-hairline);
  align-items: baseline;
}
.rule-item:last-child {
  border-bottom: none;
}
.rule-num {
  font-family: var(--font-mono);
  font-size: var(--text-mono-sm);
  letter-spacing: 0.2em;
  color: var(--color-accent);
  font-feature-settings: 'tnum','lnum';
}
.rule-text {
  font-size: 29rpx;
  line-height: 1.55;
  color: var(--color-fg);
}

/* === §5.10 空状态 === */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 200rpx 60rpx 120rpx;
  text-align: center;
}
.empty-icon {
  color: var(--color-muted);
  margin-bottom: 32rpx;
}
.empty-title {
  font-family: var(--font-display);
  font-size: 40rpx;
  color: var(--color-fg);
  margin-bottom: 16rpx;
}
.empty-desc {
  font-size: 26rpx;
  color: var(--color-muted);
  margin-bottom: 64rpx;
  line-height: 1.5;
}
.empty-state .cta-primary {
  width: 320rpx;
}

/* === §5.11 Hero（深底详情页顶部） ===
   flex 列向居中：保证短标题/长标题都在可用空间里垂直居中，避免底部留大块空白 */
.hero {
  position: relative;
  min-height: 600rpx;
  background: radial-gradient(120% 80% at 100% 0%, var(--color-emerald) 0%, transparent 55%),
              linear-gradient(170deg, var(--color-emerald-deep) 0%, #14201a 100%);
  color: var(--color-bg);
  overflow: hidden;
  padding: 200rpx var(--space-5) var(--space-6);
  display: flex;
  flex-direction: column;
  justify-content: center;
}
.hero-kicker {
  font-family: var(--font-mono);
  text-transform: uppercase;
  font-size: 21rpx;
  letter-spacing: 0.24em;
  color: var(--color-accent);
  display: inline-flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 28rpx;
}
.hero-kicker::before {
  content: '';
  display: inline-block;
  width: 36rpx;
  height: 1rpx;
  background: var(--color-accent);
}
.hero-title {
  font-family: var(--font-display);
  font-weight: 500;
  font-size: var(--text-display-lg);
  line-height: 1.06;
  margin: 0;
  color: var(--color-bg);
}
.hero-organiser {
  margin-top: 28rpx;
  font-size: var(--text-body-sm);
  color: rgba(248, 244, 232, 0.78);
}
.hero-organiser .sep {
  display: inline-block;
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background: rgba(248, 244, 232, 0.5);
  vertical-align: middle;
  margin: 0 16rpx;
}
.hero-crest {
  position: absolute;
  top: 220rpx;
  right: 48rpx;
  width: 112rpx;
  height: 112rpx;
  border: 1rpx solid var(--color-accent);
  border-radius: 50%;
  display: grid;
  place-items: center;
  color: var(--color-accent);
  font-family: var(--font-display);
  font-size: 44rpx;
  font-weight: 500;
}

/* === Masthead（自定义顶栏） === */
.masthead {
  padding: 176rpx 48rpx 28rpx;
  display: grid;
  grid-template-columns: 1fr auto;
  column-gap: 24rpx;
  align-items: end;
  border-bottom: var(--border-hairline);
  margin-bottom: var(--space-4);
}
.masthead-left {
  min-width: 0;
}
.wordmark {
  font-family: var(--font-display);
  font-size: 44rpx;
  font-weight: 500;
  color: var(--color-fg);
  line-height: 1;
}
.wordmark-caption {
  margin-top: 12rpx;
  font-family: var(--font-mono);
  font-size: 19rpx;
  letter-spacing: 0.24em;
  color: var(--color-muted);
  text-transform: uppercase;
}
.masthead-actions {
  display: flex;
  gap: 20rpx;
}
.icon-pill {
  width: 68rpx;
  height: 68rpx;
  border: 1rpx solid var(--color-border);
  border-radius: 50%;
  display: grid;
  place-items: center;
  color: var(--color-muted);
  background: none;
}

/* 通用返回按钮（custom 导航子页用）— 浅底页面专用，深色描边
   深底 hero 页面（activity-detail / tournament-detail）用各自页内的 topnav 实现
   ⚠️ top 值由页面 wxml 的 inline style 注入（来自 app.globalData.nav.navTopRpx），
   保证按钮与右上角胶囊垂直居中。CSS 不写死 top。 */
.page-back {
  position: absolute;
  left: 32rpx;
  width: 64rpx;
  height: 64rpx;
  border: 1rpx solid var(--color-border);
  border-radius: 50%;
  display: grid;
  place-items: center;
  background: var(--color-bg);
  z-index: 50;
}
.page-back image {
  width: 32rpx;
  height: 32rpx;
}

/* === 辅助布局类 === */
.row {
  display: flex;
  align-items: center;
}
.row-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.flex1 { flex: 1; }
.divider {
  height: 1rpx;
  background: var(--color-border);
  margin: 16rpx 0;
}
.muted {
  color: var(--color-muted);
  font-size: var(--text-body-sm);
}
.title {
  font-family: var(--font-display);
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-fg);
}

/* === 按钮兼容旧类名（统一防溢出：min-height + line-height + box-sizing） === */
.btn-primary {
  background: var(--color-emerald-deep);
  color: var(--color-bg);
  border: 1rpx solid var(--color-emerald-deep);
  border-radius: 0;
  font-size: var(--text-body-lg);
  line-height: 1.4;
  padding: 20rpx 36rpx;
  font-weight: 500;
  min-height: 88rpx;
  box-sizing: border-box;
  white-space: normal;
  word-break: break-word;
}
.btn-primary[disabled] {
  background: var(--color-disabled);
  border-color: var(--color-disabled);
  color: var(--color-surface);
}
.btn-default {
  background: transparent;
  color: var(--color-fg);
  border: 1rpx solid var(--color-fg);
  border-radius: 0;
  font-size: var(--text-body-lg);
  line-height: 1.4;
  padding: 20rpx 36rpx;
  min-height: 88rpx;
  box-sizing: border-box;
  white-space: normal;
  word-break: break-word;
}
.btn-danger {
  background: transparent;
  color: var(--color-danger);
  border: 1rpx solid var(--color-danger);
  border-radius: 0;
  font-size: var(--text-body-lg);
  line-height: 1.4;
  padding: 20rpx 36rpx;
  min-height: 88rpx;
  box-sizing: border-box;
  white-space: normal;
  word-break: break-word;
}

/* === FAB === */
.fab {
  position: fixed;
  right: 40rpx;
  bottom: 120rpx;
  width: 100rpx;
  height: 100rpx;
  background: var(--color-emerald-deep);
  color: var(--color-bg);
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 0;
  box-shadow: 0 4rpx 16rpx rgba(36, 58, 48, 0.4);
}

/* === CTA 固定底栏 === */
.cta-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: var(--color-surface);
  border-top: var(--border-hairline);
  padding: 28rpx 40rpx 60rpx;
  display: grid;
  grid-template-columns: auto 1fr;
  gap: 28rpx;
  align-items: center;
  z-index: 40;
}
.cta-bar .status-num {
  font-family: var(--font-display);
  font-size: 44rpx;
  color: var(--color-fg);
  font-feature-settings: 'tnum', 'lnum';
  letter-spacing: -0.01em;
}
.cta-bar .status-num em {
  font-style: normal;
  color: var(--color-muted);
  font-size: 30rpx;
}
.cta-bar .status-label {
  display: block;
  font-family: var(--font-mono);
  font-size: 18rpx;
  color: var(--color-muted);
  text-transform: uppercase;
  margin-top: 10rpx;
}

/* === 名册（双列布局） === */
.roster {
  display: grid;
  grid-template-columns: 1fr 1fr;
  column-gap: 36rpx;
  row-gap: 0;
  border-top: var(--border-hairline);
}

/* === Tab 切换 === */
.tab-bar {
  display: flex;
  border-bottom: var(--border-hairline);
  margin-bottom: var(--space-4);
}
.tab-item {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-family: var(--font-body);
  font-size: var(--text-mono-md);
  color: var(--color-muted);
  position: relative;
}
.tab-item.tab-active {
  color: var(--color-fg);
}
.tab-item.tab-active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 20%;
  right: 20%;
  height: 2rpx;
  background: var(--color-fg);
}

/* === 统计数字行 === */
.stats-row {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: var(--space-2);
  text-align: center;
}
.stat-item .stat-num {
  font-family: var(--font-display);
  font-size: 44rpx;
  color: var(--color-fg);
  font-feature-settings: 'tnum', 'lnum';
}
.stat-item .stat-label {
  font-family: var(--font-mono);
  font-size: 18rpx;
  color: var(--color-muted);
  text-transform: uppercase;
  margin-top: 8rpx;
}
.win-color { color: var(--color-success); }
.loss-color { color: var(--color-danger); }
.points-color { color: var(--color-accent); }
.elo-color { color: var(--color-emerald); }

/* === 字体角色工具类 === */
.display-num { font-family: var(--font-display); font-feature-settings: 'tnum','lnum'; }
.mono-unit { font-family: var(--font-mono); font-size: var(--text-mono-md); color: var(--color-muted); letter-spacing: 0.1em; text-transform: uppercase; margin-left: 4rpx; }

/* === 排行榜行 === */
.ranking-row {
  display: grid;
  grid-template-columns: 56rpx 60rpx 1fr auto;
  column-gap: 20rpx;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: var(--border-hairline);
}
.ranking-row.my-row {
  background: var(--color-surface);
  border-left: var(--border-accent);
  padding-left: 16rpx;
}
.ranking-rank {
  font-family: var(--font-mono);
  font-size: var(--text-body-lg);
  color: var(--color-muted);
  font-feature-settings: 'tnum','lnum';
  text-align: center;
}
.ranking-rank.top3 {
  color: var(--color-accent);
  font-size: var(--text-display-sm);
