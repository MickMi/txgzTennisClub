/* === emerald-heritage Design Tokens === */
page {
  /* 色板 */
  --color-bg:        #f1ece0;
  --color-surface:   #f8f4e8;
  --color-border:    #ddd6c4;
  --color-fg:        #1f2e22;
  --color-muted:     #5d6e63;
  --color-disabled:  #b6b29f;
  --color-emerald-deep: #243a30;
  --color-emerald:      #2d5443;
  --color-accent:    #b87a36;
  --color-success:   #2d5443;
  --color-warning:   #b87a36;
  --color-danger:    #8b3a3a;
  --color-info:      #5d6e63;

  /* 字体 */
  --font-display: 'Iowan Old Style', 'Charter', 'Source Han Serif SC', 'Songti SC', Georgia, serif;
  --font-body: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Hiragino Sans GB', 'Segoe UI', system-ui, sans-serif;
  --font-mono: ui-monospace, 'SF Mono', 'JetBrains Mono', Menlo, monospace;

  /* 字号阶 */
  --text-display-xl: 160rpx;
  --text-display-lg: 68rpx;
  --text-display-md: 48rpx;
  --text-display-sm: 36rpx;
  --text-body-lg: 30rpx;
  --text-body: 28rpx;
  --text-body-sm: 24rpx;
  --text-mono-md: 22rpx;
  --text-mono-sm: 20rpx;

  /* 间距阶 */
  --space-1:  8rpx;
  --space-2:  16rpx;
  --space-3:  24rpx;
  --space-4:  32rpx;
  --space-5:  48rpx;
  --space-6:  64rpx;
  --space-7:  96rpx;

  /* 圆角 */
  --radius-none: 0;
  --radius-sm:   4rpx;
  --radius-md:   8rpx;
  --radius-lg:   16rpx;
  --radius-pill: 999rpx;

  /* 边线 */
  --border-hairline: 1rpx solid var(--color-border);
  --border-strong:   1rpx solid var(--color-fg);
  --border-accent:   2rpx solid var(--color-accent);

  /* 阴影（仅模态用） */
  --shadow-modal: 0 8rpx 32rpx rgba(20, 30, 25, 0.18);

  /* 基础样式 */
  background: var(--color-bg);
  font-size: var(--text-body);
  color: var(--color-fg);
  font-family: var(--font-body);
}

.container {
  padding: var(--space-3);
  box-sizing: border-box;
}

.card {
  background: var(--color-surface);
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-fg);
}

.muted {
  color: var(--color-muted);
  font-size: var(--text-body-sm);
}

.tag {
  display: inline-block;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  background: var(--color-surface);
  color: var(--color-emerald-deep);
  font-size: var(--text-mono-md);
  margin-right: 8rpx;
}

.tag-gray {
  background: var(--color-border);
  color: var(--color-muted);
}

.btn-primary {
  background: var(--color-emerald-deep);
  color: var(--color-bg);
  border-radius: 12rpx;
  font-size: var(--text-body-lg);
}

.btn-primary[disabled] {
  background: var(--color-disabled);
  color: var(--color-surface);
}

.btn-default {
  background: var(--color-surface);
  color: var(--color-fg);
  border: 1rpx solid var(--color-fg);
  border-radius: 12rpx;
  font-size: var(--text-body-lg);
}

.btn-danger {
  background: var(--color-surface);
  color: var(--color-danger);
  border: 1rpx solid var(--color-danger);
  border-radius: 12rpx;
  font-size: var(--text-body-lg);
}

.empty {
  text-align: center;
  color: var(--color-muted);
  padding: 80rpx 0;
  font-size: 26rpx;
}

/* 空状态引导 - 完整版（列表页使用） */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 40rpx 80rpx;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 30rpx;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-fg);
  margin-bottom: 16rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: var(--color-muted);
  text-align: center;
  margin-bottom: 48rpx;
}

.empty-btn {
  width: 320rpx;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 28rpx;
  padding: 0;
}

.fab {
  position: fixed;
  right: 40rpx;
  bottom: 60rpx;
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: var(--color-emerald-deep);
  color: var(--color-bg);
  font-size: 60rpx;
  line-height: 96rpx;
  text-align: center;
  box-shadow: 0 4rpx 16rpx rgba(36, 58, 48, 0.4);
}

.row {
  display: flex;
  align-items: center;
}

.row-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.divider {
  height: 1rpx;
  background: var(--color-border);
  margin: 16rpx 0;
}
